2026-11-26T15:33:36.6987749Z ##[group]Run #!/bin/bash
2026-11-26T15:33:36.6988712Z #!/bin/bash
2026-11-26T15:33:36.6989077Z # Substitute environment variables in install-dir input
2026-11-26T15:33:36.6989545Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:33:36.6989891Z 
2026-11-26T15:33:36.6990190Z # cosign install script
2026-11-26T15:33:36.6990506Z shopt -s expand_aliases
2026-11-26T15:33:36.6991096Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:33:36.6991556Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:33:36.6991965Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:33:36.6992310Z else
2026-11-26T15:33:36.6992784Z   alias log_info="echo \"INFO:\""
2026-11-26T15:33:36.6993186Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:33:36.6993510Z fi
2026-11-26T15:33:36.6993787Z set -e
2026-11-26T15:33:36.6994076Z 
2026-11-26T15:33:36.6994403Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:33:36.6994835Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:33:36.6995336Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:33:36.6995862Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:33:36.6996368Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:33:36.6996842Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:33:36.6997435Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:33:36.6997925Z 
2026-11-26T15:33:36.6998224Z # This function helps compare versions.
2026-11-26T15:33:36.6998702Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:33:36.6999125Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:33:36.6999511Z is_version_ge() {
2026-11-26T15:33:36.6999882Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:33:36.7000255Z }
2026-11-26T15:33:36.7000546Z 
2026-11-26T15:33:36.7000908Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:33:36.7001323Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:33:36.7001795Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:33:36.7002171Z   version_num="${input_cosign_release}"
2026-11-26T15:33:36.7002547Z   version_num="${version_num#v}"
2026-11-26T15:33:36.7002993Z 
2026-11-26T15:33:36.7003325Z   # Check if version is less than v2.0.0
2026-11-26T15:33:36.7003728Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:33:36.7004162Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:33:36.7004607Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:33:36.7005035Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:33:36.7005542Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:33:36.7005962Z     exit 1
2026-11-26T15:33:36.7006266Z   fi
2026-11-26T15:33:36.7006525Z fi
2026-11-26T15:33:36.7006914Z 
2026-11-26T15:33:36.7007183Z mkdir -p "${install_dir}"
2026-11-26T15:33:36.7007525Z 
2026-11-26T15:33:36.7007827Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:33:36.7008293Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:33:36.7008696Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:33:36.7009091Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:33:36.7009484Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:33:36.7009867Z   exit 0
2026-11-26T15:33:36.7010178Z fi
2026-11-26T15:33:36.7010445Z 
2026-11-26T15:33:36.7010741Z shaprog() {
2026-11-26T15:33:36.7011047Z   case ${runner_os} in
2026-11-26T15:33:36.7011362Z     Linux|linux)
2026-11-26T15:33:36.7011674Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:33:36.7012027Z       ;;
2026-11-26T15:33:36.7012363Z     macOS|macos)
2026-11-26T15:33:36.7012830Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:33:36.7013157Z       ;;
2026-11-26T15:33:36.7013451Z     Windows|windows)
2026-11-26T15:33:36.7013982Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:33:36.7014487Z       ;;
2026-11-26T15:33:36.7014740Z     *)
2026-11-26T15:33:36.7015112Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:33:36.7015446Z       exit 1
2026-11-26T15:33:36.7015723Z       ;;
2026-11-26T15:33:36.7015983Z   esac
2026-11-26T15:33:36.7016266Z }
