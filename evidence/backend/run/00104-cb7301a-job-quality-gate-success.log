2026-11-26T14:14:15.9694800Z #!/bin/bash
2026-11-26T14:14:15.9695112Z # Substitute environment variables in install-dir input
2026-11-26T14:14:15.9695498Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:14:15.9695804Z 
2026-11-26T14:14:15.9696022Z # cosign install script
2026-11-26T14:14:15.9696287Z shopt -s expand_aliases
2026-11-26T14:14:15.9696846Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:14:15.9697159Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:14:15.9697510Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:14:15.9697806Z else
2026-11-26T14:14:15.9698036Z   alias log_info="echo \"INFO:\""
2026-11-26T14:14:15.9698318Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:14:15.9698593Z fi
2026-11-26T14:14:15.9698789Z set -e
2026-11-26T14:14:15.9699000Z 
2026-11-26T14:14:15.9699228Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:14:15.9699618Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:14:15.9700071Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:14:15.9700518Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:14:15.9700971Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:14:15.9701398Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:14:15.9701899Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:14:15.9702309Z 
2026-11-26T14:14:15.9702536Z # This function helps compare versions.
2026-11-26T14:14:15.9703032Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:14:15.9703367Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:14:15.9703658Z is_version_ge() {
2026-11-26T14:14:15.9723211Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:14:15.9723741Z }
2026-11-26T14:14:15.9724020Z 
2026-11-26T14:14:15.9724442Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:14:15.9725027Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:14:15.9725598Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:14:15.9726111Z   version_num="${input_cosign_release}"
2026-11-26T14:14:15.9726750Z   version_num="${version_num#v}"
2026-11-26T14:14:15.9727162Z 
2026-11-26T14:14:15.9727511Z   # Check if version is less than v2.0.0
2026-11-26T14:14:15.9728036Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:14:15.9728682Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:14:15.9729368Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:14:15.9729946Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:14:15.9730667Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:14:15.9731325Z     exit 1
2026-11-26T14:14:15.9731662Z   fi
2026-11-26T14:14:15.9731974Z fi
2026-11-26T14:14:15.9732515Z 
2026-11-26T14:14:15.9732842Z mkdir -p "${install_dir}"
2026-11-26T14:14:15.9733277Z 
2026-11-26T14:14:15.9733685Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:14:15.9734339Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:14:15.9734883Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:14:15.9735225Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:14:15.9735585Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:14:15.9735875Z   exit 0
2026-11-26T14:14:15.9736086Z fi
