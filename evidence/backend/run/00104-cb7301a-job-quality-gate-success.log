2026-11-26T14:14:15.9739144Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:14:15.9739593Z       ;;
2026-11-26T14:14:15.9739799Z     *)
