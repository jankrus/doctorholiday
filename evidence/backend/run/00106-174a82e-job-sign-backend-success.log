2026-11-26T15:32:54.8309875Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-26T15:32:54.8332025Z ##[group]Run #!/bin/bash
2026-11-26T15:32:54.8333071Z #!/bin/bash
2026-11-26T15:32:54.8333546Z # Substitute environment variables in install-dir input
2026-11-26T15:32:54.8333997Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:32:54.8334373Z 
2026-11-26T15:32:54.8334671Z # cosign install script
2026-11-26T15:32:54.8335037Z shopt -s expand_aliases
2026-11-26T15:32:54.8335457Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:32:54.8335877Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:32:54.8336270Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:32:54.8336645Z else
2026-11-26T15:32:54.8336923Z   alias log_info="echo \"INFO:\""
2026-11-26T15:32:54.8337318Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:32:54.8337641Z fi
2026-11-26T15:32:54.8337909Z set -e
2026-11-26T15:32:54.8338420Z 
2026-11-26T15:32:54.8338716Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:32:54.8339165Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:32:54.8339671Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:32:54.8340198Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:32:54.8340666Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:32:54.8341141Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:32:54.8341737Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:32:54.8342230Z 
2026-11-26T15:32:54.8342508Z # This function helps compare versions.
2026-11-26T15:32:54.8343064Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:32:54.8343475Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:32:54.8343832Z is_version_ge() {
2026-11-26T15:32:54.8344188Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:32:54.8344598Z }
2026-11-26T15:32:54.8344856Z 
2026-11-26T15:32:54.8345182Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:32:54.8345652Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:32:54.8346141Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:32:54.8346522Z   version_num="${input_cosign_release}"
2026-11-26T15:32:54.8346859Z   version_num="${version_num#v}"
2026-11-26T15:32:54.8347195Z 
2026-11-26T15:32:54.8347471Z   # Check if version is less than v2.0.0
2026-11-26T15:32:54.8347858Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:32:54.8348692Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:32:54.8349176Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:32:54.8349624Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:32:54.8350140Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:32:54.8350579Z     exit 1
2026-11-26T15:32:54.8350844Z   fi
2026-11-26T15:32:54.8351128Z fi
2026-11-26T15:32:54.8351571Z 
2026-11-26T15:32:54.8351848Z mkdir -p "${install_dir}"
2026-11-26T15:32:54.8352172Z 
2026-11-26T15:32:54.8352493Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:32:54.8352934Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:32:54.8353353Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:32:54.8353732Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:32:54.8354281Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:32:54.8354639Z   exit 0
2026-11-26T15:32:54.8354913Z fi
2026-11-26T15:32:54.8355213Z 
2026-11-26T15:32:54.8355463Z shaprog() {
2026-11-26T15:32:54.8355753Z   case ${runner_os} in
2026-11-26T15:32:54.8356065Z     Linux|linux)
2026-11-26T15:32:54.8356453Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:32:54.8356847Z       ;;
2026-11-26T15:32:54.8357167Z     macOS|macos)
2026-11-26T15:32:54.8357504Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:32:54.8357878Z       ;;
2026-11-26T15:32:54.8358142Z     Windows|windows)
2026-11-26T15:32:54.8358881Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:32:54.8359411Z       ;;
2026-11-26T15:32:54.8359712Z     *)
2026-11-26T15:32:54.8360017Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:32:54.8360412Z       exit 1
2026-11-26T15:32:54.8360695Z       ;;
2026-11-26T15:32:54.8360956Z   esac
2026-11-26T15:32:54.8361227Z }
