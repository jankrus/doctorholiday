2026-11-26T15:33:02.0864769Z #!/bin/bash
2026-11-26T15:33:02.0865146Z # Substitute environment variables in install-dir input
2026-11-26T15:33:02.0865582Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:33:02.0865977Z 
2026-11-26T15:33:02.0866259Z # cosign install script
2026-11-26T15:33:02.0866600Z shopt -s expand_aliases
2026-11-26T15:33:02.0867065Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:33:02.0867458Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:33:02.0867889Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:33:02.0868271Z else
2026-11-26T15:33:02.0868574Z   alias log_info="echo \"INFO:\""
2026-11-26T15:33:02.0868929Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:33:02.0869472Z fi
2026-11-26T15:33:02.0869731Z set -e
2026-11-26T15:33:02.0870035Z 
2026-11-26T15:33:02.0870356Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:33:02.0870798Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:33:02.0871293Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:33:02.0871843Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:33:02.0872626Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:33:02.0873128Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:33:02.0873752Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:33:02.0874211Z 
2026-11-26T15:33:02.0874513Z # This function helps compare versions.
2026-11-26T15:33:02.0875016Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:33:02.0875465Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:33:02.0875797Z is_version_ge() {
2026-11-26T15:33:02.0876176Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:33:02.0876574Z }
2026-11-26T15:33:02.0876922Z 
2026-11-26T15:33:02.0877275Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:33:02.0877709Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:33:02.0878229Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:33:02.0878616Z   version_num="${input_cosign_release}"
2026-11-26T15:33:02.0878970Z   version_num="${version_num#v}"
2026-11-26T15:33:02.0879330Z 
2026-11-26T15:33:02.0879625Z   # Check if version is less than v2.0.0
2026-11-26T15:33:02.0880000Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:33:02.0880432Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:33:02.0880915Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:33:02.0881338Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:33:02.0881808Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:33:02.0882454Z     exit 1
2026-11-26T15:33:02.0882765Z   fi
2026-11-26T15:33:02.0883050Z fi
2026-11-26T15:33:02.0883423Z 
2026-11-26T15:33:02.0883763Z mkdir -p "${install_dir}"
2026-11-26T15:33:02.0884091Z 
2026-11-26T15:33:02.0884390Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:33:02.0884864Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:33:02.0885286Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:33:02.0885670Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:33:02.0886130Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:33:02.0886552Z   exit 0
2026-11-26T15:33:02.0886807Z fi
2026-11-26T15:33:02.0887117Z 
2026-11-26T15:33:02.0887377Z shaprog() {
2026-11-26T15:33:02.0887692Z   case ${runner_os} in
2026-11-26T15:33:02.0888005Z     Linux|linux)
2026-11-26T15:33:02.0888411Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:33:02.0888758Z       ;;
2026-11-26T15:33:02.0889029Z     macOS|macos)
2026-11-26T15:33:02.0889352Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:33:02.0889697Z       ;;
2026-11-26T15:33:02.0889994Z     Windows|windows)
2026-11-26T15:33:02.0890490Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:33:02.0891031Z       ;;
2026-11-26T15:33:02.0891301Z     *)
2026-11-26T15:33:02.0891647Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:33:02.0891974Z       exit 1
2026-11-26T15:33:02.0892456Z       ;;
2026-11-26T15:33:02.0892756Z   esac
2026-11-26T15:33:02.0893028Z }
2026-11-26T15:33:02.0893294Z 
2026-11-26T15:33:02.0893753Z ## curl -sL https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign_checksums.txt |\
2026-11-26T15:33:02.0894428Z ##   gawk 'match($2,/^cosign-([[:alnum:]]+)-([[:alnum:]]+)(\.[[:alnum:]]+)?$/,a){printf "bootstrap_%s_%s_sha=\"%s\"\n",a[1],a[2],$1}' |\
2026-11-26T15:33:02.0894917Z ##   LANG=C sort
2026-11-26T15:33:02.0895249Z bootstrap_version='v3.1.4'
2026-11-26T15:33:02.0895725Z bootstrap_darwin_amd64_sha="9d1e4abe2b6be279ed0d2ff706fde1ccd738747c834e3e6d44039c238867334f"
2026-11-26T15:33:02.0896459Z bootstrap_darwin_arm64_sha="9f9b8cd557cf2e5b3df3373a00baa005a86b02391e3e06dd0ce37b3a1533d3a4"
2026-11-26T15:33:02.0897076Z bootstrap_linux_amd64_sha="424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa"
2026-11-26T15:33:02.0897688Z bootstrap_linux_arm64_sha="ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2"
2026-11-26T15:33:02.0898281Z bootstrap_linux_arm_sha="09e77a313910cf5c4774508d85d017d9c60983f41bf657f83ecbd3892f7952cb"
2026-11-26T15:33:02.0898985Z bootstrap_linux_ppc64le_sha="0887fca23319ea017cc827e6a845ba83722a36bf9e932f35c747ca83c14cec49"
2026-11-26T15:33:02.0899701Z bootstrap_linux_riscv64_sha="24f3865df0fd9b055827b888d56e13583112ac7d4c87b45967af1f0febf35455"
2026-11-26T15:33:02.0900352Z bootstrap_linux_s390x_sha="777978d576af893a3daf1fcf3b0e9178cebcbc083a669f6125b6c97b8e1fe433"
2026-11-26T15:33:02.0901063Z bootstrap_windows_amd64_sha="cbe953787074611f1334cbf37dc1cf953995bb8c45398eb4fc7bb781d29c1f2a"
2026-11-26T15:33:02.0901508Z 
2026-11-26T15:33:02.0901816Z cosign_executable_name=cosign
2026-11-26T15:33:02.0902393Z bootstrap_executable_name=cosign-bootstrap
2026-11-26T15:33:02.0902831Z 
2026-11-26T15:33:02.0903115Z trap "popd >/dev/null" EXIT
2026-11-26T15:33:02.0903471Z 
2026-11-26T15:33:02.0903800Z pushd "${install_dir}" > /dev/null
2026-11-26T15:33:02.0904135Z 
2026-11-26T15:33:02.0904379Z case ${runner_os} in
2026-11-26T15:33:02.0904722Z   Linux|linux)
2026-11-26T15:33:02.0905153Z     case ${runner_arch} in
2026-11-26T15:33:02.0905482Z       X64|amd64)
2026-11-26T15:33:02.0905842Z         bootstrap_filename='cosign-linux-amd64'
2026-11-26T15:33:02.0906283Z         bootstrap_sha=${bootstrap_linux_amd64_sha}
2026-11-26T15:33:02.0906724Z         desired_cosign_filename='cosign-linux-amd64'
2026-11-26T15:33:02.0907071Z         ;;
2026-11-26T15:33:02.0907354Z 
2026-11-26T15:33:02.0907635Z       ARM|arm)
2026-11-26T15:33:02.0908014Z         bootstrap_filename='cosign-linux-arm'
2026-11-26T15:33:02.0908418Z         bootstrap_sha=${bootstrap_linux_arm_sha}
2026-11-26T15:33:02.0908858Z         desired_cosign_filename='cosign-linux-arm'
2026-11-26T15:33:02.0909179Z         ;;
2026-11-26T15:33:02.0909454Z 
2026-11-26T15:33:02.0909742Z       ARM64|arm64)
2026-11-26T15:33:02.0910129Z         bootstrap_filename='cosign-linux-arm64'
2026-11-26T15:33:02.0910503Z         bootstrap_sha=${bootstrap_linux_arm64_sha}
2026-11-26T15:33:02.0910896Z         desired_cosign_filename='cosign-linux-arm64'
2026-11-26T15:33:02.0911283Z         ;;
2026-11-26T15:33:02.0911541Z 
2026-11-26T15:33:02.0911798Z       *)
2026-11-26T15:33:02.0912120Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T15:33:02.0912707Z         exit 1
2026-11-26T15:33:02.0912981Z         ;;
2026-11-26T15:33:02.0913253Z     esac
2026-11-26T15:33:02.0913515Z     ;;
2026-11-26T15:33:02.0913818Z 
2026-11-26T15:33:02.0914055Z   macOS|macos)
2026-11-26T15:33:02.0914354Z     case ${runner_arch} in
2026-11-26T15:33:02.0914660Z       X64|amd64)
2026-11-26T15:33:02.0915029Z         bootstrap_filename='cosign-darwin-amd64'
2026-11-26T15:33:02.0915407Z         bootstrap_sha=${bootstrap_darwin_amd64_sha}
2026-11-26T15:33:02.0915806Z         desired_cosign_filename='cosign-darwin-amd64'
2026-11-26T15:33:02.0916201Z         ;;
2026-11-26T15:33:02.0916463Z 
2026-11-26T15:33:02.0916839Z       ARM64|arm64)
2026-11-26T15:33:02.0917199Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T15:33:02.0917624Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T15:33:02.0918104Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T15:33:02.0918455Z         ;;
2026-11-26T15:33:02.0918746Z 
2026-11-26T15:33:02.0919013Z       *)
2026-11-26T15:33:02.0919318Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T15:33:02.0919711Z         exit 1
2026-11-26T15:33:02.0920063Z         ;;
2026-11-26T15:33:02.0920331Z     esac
2026-11-26T15:33:02.0920586Z     ;;
2026-11-26T15:33:02.0920872Z 
2026-11-26T15:33:02.0921180Z   Windows|windows)
2026-11-26T15:33:02.0921470Z     case ${runner_arch} in
2026-11-26T15:33:02.0921785Z       X64|amd64)
2026-11-26T15:33:02.0922157Z         bootstrap_filename='cosign-windows-amd64.exe'
2026-11-26T15:33:02.0922702Z         bootstrap_sha=${bootstrap_windows_amd64_sha}
2026-11-26T15:33:02.0923108Z         desired_cosign_filename='cosign-windows-amd64.exe'
2026-11-26T15:33:02.0923536Z         cosign_executable_name=cosign.exe
2026-11-26T15:33:02.0923942Z         bootstrap_executable_name=cosign-bootstrap.exe
2026-11-26T15:33:02.0924310Z         ;;
2026-11-26T15:33:02.0924559Z       *)
2026-11-26T15:33:02.0924943Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T15:33:02.0925295Z         exit 1
2026-11-26T15:33:02.0925574Z         ;;
2026-11-26T15:33:02.0925846Z     esac
2026-11-26T15:33:02.0926163Z     ;;
2026-11-26T15:33:02.0926509Z   *)
2026-11-26T15:33:02.0926804Z     log_error "unsupported os ${runner_os}"
2026-11-26T15:33:02.0927155Z     exit 1
2026-11-26T15:33:02.0927446Z     ;;
2026-11-26T15:33:02.0927722Z esac
2026-11-26T15:33:02.0927980Z 
2026-11-26T15:33:02.0928257Z SUDO=
2026-11-26T15:33:02.0928633Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T15:33:02.0929041Z   SUDO=sudo
2026-11-26T15:33:02.0929313Z fi
2026-11-26T15:33:02.0929609Z 
2026-11-26T15:33:02.0929911Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T15:33:02.0930697Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T15:33:02.0931846Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T15:33:02.0932723Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T15:33:02.0933182Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
2026-11-26T15:33:02.0933708Z   log_error "Unable to validate cosign version: '${input_cosign_release}'"
2026-11-26T15:33:02.0934110Z   exit 1
2026-11-26T15:33:02.0934362Z fi
2026-11-26T15:33:02.0934669Z $SUDO chmod +x "${bootstrap_executable_name}"
2026-11-26T15:33:02.0935028Z 
2026-11-26T15:33:02.0935453Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T15:33:02.0935926Z if [[ "${input_cosign_release}" == "${bootstrap_version}" ]]; then
2026-11-26T15:33:02.0936479Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T15:33:02.0937060Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
2026-11-26T15:33:02.0937432Z   exit 0
2026-11-26T15:33:02.0937701Z fi
2026-11-26T15:33:02.0937966Z 
2026-11-26T15:33:02.0938311Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T15:33:02.0938783Z if [[ "${input_cosign_release}" =~ $semver ]]; then
2026-11-26T15:33:02.0939237Z   log_info "Custom cosign version '${input_cosign_release}' requested"
2026-11-26T15:33:02.0939635Z else
2026-11-26T15:33:02.0940032Z   log_error "Unable to validate requested cosign version: '${input_cosign_release}'"
2026-11-26T15:33:02.0940431Z   exit 1
2026-11-26T15:33:02.0940723Z fi
2026-11-26T15:33:02.0940994Z 
2026-11-26T15:33:02.0941310Z # Download custom cosign
2026-11-26T15:33:02.0942016Z log_info "Downloading platform-specific version '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}"
2026-11-26T15:33:02.0943220Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T15:33:02.0943950Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
2026-11-26T15:33:02.0944303Z 
2026-11-26T15:33:02.0944642Z # same hash means it is the same release
2026-11-26T15:33:02.0945014Z if [[ "$shaCustom" != "$shaBootstrap" ]]; then
2026-11-26T15:33:02.0945732Z   log_info "Downloading cosign public key '${input_cosign_release}' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub"
2026-11-26T15:33:02.0946683Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub
2026-11-26T15:33:02.0947393Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T15:33:02.0947822Z 
2026-11-26T15:33:02.0948180Z   log_info "Verifying public key matches expected value"
2026-11-26T15:33:02.0948661Z   $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "$RELEASE_COSIGN_PUB_KEY" -o public.key
2026-11-26T15:33:02.0949112Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T15:33:02.0949544Z   if [[ "$sha_fetched_key" != "$RELEASE_COSIGN_PUB_KEY_SHA" ]]; then
2026-11-26T15:33:02.0950008Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T15:33:02.0950426Z     exit 1
2026-11-26T15:33:02.0950696Z   fi
2026-11-26T15:33:02.0950984Z 
2026-11-26T15:33:02.0951293Z   if is_version_ge "3.0.1" "$version_num"; then
2026-11-26T15:33:02.0951758Z     # we're trying to get something greater than or equal to v3.0.1
2026-11-26T15:33:02.0952340Z     keyless_signature_file=${desired_cosign_filename}.sigstore.json
2026-11-26T15:33:02.0953198Z     log_info "Downloading keyless verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T15:33:02.0954221Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T15:33:02.0954815Z 
2026-11-26T15:33:02.0955193Z     log_info "Using bootstrap cosign to verify keyless signature of desired cosign version"
2026-11-26T15:33:02.0956142Z     "./${bootstrap_executable_name}" verify-blob --certificate-identity=keyless@projectsigstore.iam.gserviceaccount.com --certificate-oidc-issuer=https://accounts.google.com --bundle "${keyless_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:33:02.0957168Z 
2026-11-26T15:33:02.0957465Z     if is_version_ge "3.0.3" "$version_num"; then
2026-11-26T15:33:02.0957889Z       # we're trying to get something greater than or equal to v3.0.3
2026-11-26T15:33:02.0958379Z       kms_signature_file=${desired_cosign_filename}-kms.sigstore.json
2026-11-26T15:33:02.0959244Z       log_info "Downloading KMS verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T15:33:02.0960222Z       $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T15:33:02.0960807Z 
2026-11-26T15:33:02.0961160Z       log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T15:33:02.0961838Z       "./${bootstrap_executable_name}" verify-blob --key public.key --bundle "${kms_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:33:02.0962537Z     fi
2026-11-26T15:33:02.0962833Z   else
2026-11-26T15:33:02.0963145Z     signature_file=${desired_cosign_filename}.sig
2026-11-26T15:33:02.0963917Z     log_info "Downloading detached signature for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T15:33:02.0964840Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T15:33:02.0965408Z 
2026-11-26T15:33:02.0965782Z     log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T15:33:02.0966457Z     "./${bootstrap_executable_name}" verify-blob --key public.key --signature "${signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:33:02.0966998Z   fi
2026-11-26T15:33:02.0967268Z 
