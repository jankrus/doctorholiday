2026-11-26T14:13:41.4724199Z shaprog() {
2026-11-26T14:13:41.4725321Z   case ${runner_os} in
2026-11-26T14:13:41.4726571Z     Linux|linux)
2026-11-26T14:13:41.4728130Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:13:41.4729454Z       ;;
2026-11-26T14:13:41.4730541Z     macOS|macos)
2026-11-26T14:13:41.4731760Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:13:41.4733088Z       ;;
2026-11-26T14:13:41.4734160Z     Windows|windows)
2026-11-26T14:13:41.4736252Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:13:41.4738632Z       ;;
2026-11-26T14:13:41.4739662Z     *)
2026-11-26T14:13:41.4740863Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:13:41.4742285Z       exit 1
2026-11-26T14:13:41.4743359Z       ;;
2026-11-26T14:13:41.4744387Z   esac
2026-11-26T14:13:41.4745397Z }
