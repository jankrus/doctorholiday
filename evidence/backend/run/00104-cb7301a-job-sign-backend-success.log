2026-11-26T14:13:41.4638790Z #!/bin/bash
2026-11-26T14:13:41.4640240Z # Substitute environment variables in install-dir input
2026-11-26T14:13:41.4642064Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:13:41.4643535Z 
2026-11-26T14:13:41.4644573Z # cosign install script
2026-11-26T14:13:41.4645882Z shopt -s expand_aliases
2026-11-26T14:13:41.4647561Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:13:41.4649090Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:13:41.4650849Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:13:41.4652330Z else
2026-11-26T14:13:41.4653447Z   alias log_info="echo \"INFO:\""
2026-11-26T14:13:41.4654839Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:13:41.4656167Z fi
2026-11-26T14:13:41.4657409Z set -e
2026-11-26T14:13:41.4658457Z 
2026-11-26T14:13:41.4659581Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:13:41.4661398Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:13:41.4663534Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:13:41.4665651Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:13:41.4667830Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:13:41.4669915Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:13:41.4672373Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:13:41.4674380Z 
2026-11-26T14:13:41.4675515Z # This function helps compare versions.
2026-11-26T14:13:41.4677423Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:13:41.4679048Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:13:41.4680485Z is_version_ge() {
2026-11-26T14:13:41.4681914Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:13:41.4683426Z }
2026-11-26T14:13:41.4684408Z 
2026-11-26T14:13:41.4685724Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:13:41.4687592Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:13:41.4689320Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:13:41.4690930Z   version_num="${input_cosign_release}"
2026-11-26T14:13:41.4692356Z   version_num="${version_num#v}"
2026-11-26T14:13:41.4693624Z 
2026-11-26T14:13:41.4694727Z   # Check if version is less than v2.0.0
2026-11-26T14:13:41.4696285Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:13:41.4698187Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:13:41.4700131Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:13:41.4701931Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:13:41.4704010Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:13:41.4705906Z     exit 1
2026-11-26T14:13:41.4707066Z   fi
2026-11-26T14:13:41.4708072Z fi
2026-11-26T14:13:41.4709235Z 
2026-11-26T14:13:41.4710288Z mkdir -p "${install_dir}"
2026-11-26T14:13:41.4711525Z 
2026-11-26T14:13:41.4712720Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:13:41.4714596Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:13:41.4716330Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:13:41.4718020Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:13:41.4719756Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:13:41.4721187Z   exit 0
2026-11-26T14:13:41.4722216Z fi
