2026-11-26T14:16:07.6377035Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:16:07.6378359Z       ;;
2026-11-26T14:16:07.6379445Z     macOS|macos)
2026-11-26T14:16:07.6380825Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:16:07.6382191Z       ;;
2026-11-26T14:16:07.6383279Z     Windows|windows)
2026-11-26T14:16:07.6385404Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:16:07.6387574Z       ;;
2026-11-26T14:16:07.6388608Z     *)
2026-11-26T14:16:07.6389823Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:16:07.6391347Z       exit 1
2026-11-26T14:16:07.6392440Z       ;;
2026-11-26T14:16:07.6393494Z   esac
2026-11-26T14:16:07.6394520Z }
