2026-11-26T14:16:07.6262539Z #!/bin/bash
2026-11-26T14:16:07.6264011Z # Substitute environment variables in install-dir input
2026-11-26T14:16:07.6265841Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:16:07.6267304Z 
2026-11-26T14:16:07.6268345Z # cosign install script
2026-11-26T14:16:07.6269658Z shopt -s expand_aliases
2026-11-26T14:16:07.6271249Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:16:07.6272792Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:16:07.6274547Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:16:07.6276049Z else
2026-11-26T14:16:07.6277179Z   alias log_info="echo \"INFO:\""
2026-11-26T14:16:07.6278702Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:16:07.6303216Z fi
2026-11-26T14:16:07.6304292Z set -e
2026-11-26T14:16:07.6305349Z 
2026-11-26T14:16:07.6306499Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:16:07.6308374Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:16:07.6310690Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:16:07.6313128Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:16:07.6315250Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:16:07.6317379Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:16:07.6319843Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:16:07.6322166Z 
2026-11-26T14:16:07.6323337Z # This function helps compare versions.
2026-11-26T14:16:07.6325188Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:16:07.6326822Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:16:07.6328236Z is_version_ge() {
2026-11-26T14:16:07.6329707Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:16:07.6331397Z }
2026-11-26T14:16:07.6332393Z 
2026-11-26T14:16:07.6333731Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:16:07.6335526Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:16:07.6337252Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:16:07.6338872Z   version_num="${input_cosign_release}"
2026-11-26T14:16:07.6340319Z   version_num="${version_num#v}"
2026-11-26T14:16:07.6341740Z 
2026-11-26T14:16:07.6342867Z   # Check if version is less than v2.0.0
2026-11-26T14:16:07.6344452Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:16:07.6346289Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:16:07.6348268Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:16:07.6350060Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:16:07.6352517Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:16:07.6354415Z     exit 1
2026-11-26T14:16:07.6355495Z   fi
2026-11-26T14:16:07.6356507Z fi
2026-11-26T14:16:07.6357711Z 
2026-11-26T14:16:07.6358764Z mkdir -p "${install_dir}"
2026-11-26T14:16:07.6360024Z 
2026-11-26T14:16:07.6361515Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:16:07.6363401Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:16:07.6365140Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:16:07.6366733Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:16:07.6368608Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:16:07.6370038Z   exit 0
2026-11-26T14:16:07.6371261Z fi
