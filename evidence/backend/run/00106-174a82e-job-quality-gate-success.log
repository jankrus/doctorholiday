2026-11-26T15:33:26.1104447Z ##[group]Run #!/bin/bash
2026-11-26T15:33:26.1105341Z #!/bin/bash
2026-11-26T15:33:26.1105685Z # Substitute environment variables in install-dir input
2026-11-26T15:33:26.1106111Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:33:26.1106485Z 
2026-11-26T15:33:26.1106761Z # cosign install script
2026-11-26T15:33:26.1107072Z shopt -s expand_aliases
2026-11-26T15:33:26.1107459Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:33:26.1107854Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:33:26.1108513Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:33:26.1108871Z else
2026-11-26T15:33:26.1109154Z   alias log_info="echo \"INFO:\""
2026-11-26T15:33:26.1109515Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:33:26.1109868Z fi
2026-11-26T15:33:26.1110121Z set -e
2026-11-26T15:33:26.1110586Z 
2026-11-26T15:33:26.1110864Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:33:26.1111321Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:33:26.1111802Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:33:26.1112301Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:33:26.1112771Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:33:26.1113277Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:33:26.1113809Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:33:26.1114347Z 
2026-11-26T15:33:26.1114656Z # This function helps compare versions.
2026-11-26T15:33:26.1115141Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:33:26.1115536Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:33:26.1115885Z is_version_ge() {
2026-11-26T15:33:26.1116267Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:33:26.1116631Z }
2026-11-26T15:33:26.1116888Z 
2026-11-26T15:33:26.1117207Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:33:26.1117653Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:33:26.1118071Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:33:26.1118765Z   version_num="${input_cosign_release}"
2026-11-26T15:33:26.1119099Z   version_num="${version_num#v}"
2026-11-26T15:33:26.1119441Z 
2026-11-26T15:33:26.1119723Z   # Check if version is less than v2.0.0
2026-11-26T15:33:26.1120115Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:33:26.1120515Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:33:26.1121026Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:33:26.1121423Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:33:26.1121900Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:33:26.1122359Z     exit 1
2026-11-26T15:33:26.1122639Z   fi
2026-11-26T15:33:26.1122900Z fi
2026-11-26T15:33:26.1123268Z 
2026-11-26T15:33:26.1123553Z mkdir -p "${install_dir}"
2026-11-26T15:33:26.1123902Z 
2026-11-26T15:33:26.1124201Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:33:26.1124676Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:33:26.1125101Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:33:26.1125487Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:33:26.1125903Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:33:26.1126222Z   exit 0
2026-11-26T15:33:26.1126573Z fi
2026-11-26T15:33:26.1126822Z 
2026-11-26T15:33:26.1127089Z shaprog() {
2026-11-26T15:33:26.1127367Z   case ${runner_os} in
2026-11-26T15:33:26.1127712Z     Linux|linux)
2026-11-26T15:33:26.1128021Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:33:26.1128503Z       ;;
2026-11-26T15:33:26.1128807Z     macOS|macos)
2026-11-26T15:33:26.1129136Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:33:26.1129542Z       ;;
2026-11-26T15:33:26.1129823Z     Windows|windows)
2026-11-26T15:33:26.1130357Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:33:26.1130875Z       ;;
2026-11-26T15:33:26.1131156Z     *)
2026-11-26T15:33:26.1131487Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:33:26.1131835Z       exit 1
2026-11-26T15:33:26.1132121Z       ;;
2026-11-26T15:33:26.1132386Z   esac
2026-11-26T15:33:26.1132654Z }
