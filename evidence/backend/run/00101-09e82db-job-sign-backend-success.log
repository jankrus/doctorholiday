2026-11-25T13:52:02.2171448Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-25T13:52:02.2194241Z ##[group]Run #!/bin/bash
2026-11-25T13:52:02.2195243Z #!/bin/bash
2026-11-25T13:52:02.2195587Z # Substitute environment variables in install-dir input
2026-11-25T13:52:02.2196055Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:52:02.2196397Z 
2026-11-25T13:52:02.2196689Z # cosign install script
2026-11-25T13:52:02.2197085Z shopt -s expand_aliases
2026-11-25T13:52:02.2197474Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:52:02.2197866Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:52:02.2198395Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:52:02.2198780Z else
2026-11-25T13:52:02.2199076Z   alias log_info="echo \"INFO:\""
2026-11-25T13:52:02.2199413Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:52:02.2199724Z fi
2026-11-25T13:52:02.2200004Z set -e
2026-11-25T13:52:02.2200282Z 
2026-11-25T13:52:02.2200552Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:52:02.2200977Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:52:02.2201478Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:52:02.2201967Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:52:02.2202426Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:52:02.2202916Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:52:02.2203628Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:52:02.2204142Z 
2026-11-25T13:52:02.2204446Z # This function helps compare versions.
2026-11-25T13:52:02.2204930Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:52:02.2205317Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:52:02.2205656Z is_version_ge() {
2026-11-25T13:52:02.2206031Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:52:02.2206386Z }
2026-11-25T13:52:02.2206636Z 
2026-11-25T13:52:02.2206980Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:52:02.2207391Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:52:02.2207850Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:52:02.2208260Z   version_num="${input_cosign_release}"
2026-11-25T13:52:02.2208580Z   version_num="${version_num#v}"
2026-11-25T13:52:02.2208918Z 
2026-11-25T13:52:02.2209178Z   # Check if version is less than v2.0.0
2026-11-25T13:52:02.2209587Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:52:02.2209993Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:52:02.2210451Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:52:02.2210884Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:52:02.2211350Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:52:02.2211774Z     exit 1
2026-11-25T13:52:02.2212053Z   fi
2026-11-25T13:52:02.2212337Z fi
2026-11-25T13:52:02.2212673Z 
2026-11-25T13:52:02.2212965Z mkdir -p "${install_dir}"
2026-11-25T13:52:02.2213264Z 
2026-11-25T13:52:02.2213932Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:52:02.2214350Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:52:02.2214786Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:52:02.2215185Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:52:02.2215611Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:52:02.2216038Z   exit 0
2026-11-25T13:52:02.2216297Z fi
