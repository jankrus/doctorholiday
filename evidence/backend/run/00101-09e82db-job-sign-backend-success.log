2026-11-25T13:52:02.2216806Z shaprog() {
2026-11-25T13:52:02.2217139Z   case ${runner_os} in
2026-11-25T13:52:02.2217436Z     Linux|linux)
2026-11-25T13:52:02.2217745Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:52:02.2218101Z       ;;
2026-11-25T13:52:02.2218422Z     macOS|macos)
2026-11-25T13:52:02.2218783Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:52:02.2219133Z       ;;
2026-11-25T13:52:02.2219405Z     Windows|windows)
2026-11-25T13:52:02.2219944Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:52:02.2220443Z       ;;
2026-11-25T13:52:02.2220718Z     *)
2026-11-25T13:52:02.2221081Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:52:02.2221405Z       exit 1
2026-11-25T13:52:02.2221675Z       ;;
2026-11-25T13:52:02.2221936Z   esac
2026-11-25T13:52:02.2222220Z }
