2026-11-26T14:15:37.2570384Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T14:15:37.2571289Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
