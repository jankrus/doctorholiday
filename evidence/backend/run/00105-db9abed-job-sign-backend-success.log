2026-11-26T14:15:37.2563807Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T14:15:37.2564385Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
