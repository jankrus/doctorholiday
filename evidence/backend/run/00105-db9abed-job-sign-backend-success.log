2026-11-26T14:15:37.2556977Z 
2026-11-26T14:15:37.2557309Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T14:15:37.2558070Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T14:15:37.2559147Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T14:15:37.2559802Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T14:15:37.2560260Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
