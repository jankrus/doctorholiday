2026-11-26T14:15:37.2555391Z 
2026-11-26T14:15:37.2555660Z SUDO=
2026-11-26T14:15:37.2556047Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
