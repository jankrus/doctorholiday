2026-11-26T14:15:37.2544826Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T14:15:37.2545264Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T14:15:37.2545729Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T14:15:37.2546076Z         ;;
2026-11-26T14:15:37.2546348Z 
