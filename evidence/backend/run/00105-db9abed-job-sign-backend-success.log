2026-11-26T14:15:37.2522730Z ##   gawk 'match($2,/^cosign-([[:alnum:]]+)-([[:alnum:]]+)(\.[[:alnum:]]+)?$/,a){printf "bootstrap_%s_%s_sha=\"%s\"\n",a[1],a[2],$1}' |\
2026-11-26T14:15:37.2523192Z ##   LANG=C sort
