2026-11-26T14:15:37.2471177Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-26T14:15:37.2493052Z ##[group]Run #!/bin/bash
2026-11-26T14:15:37.2494045Z #!/bin/bash
2026-11-26T14:15:37.2494410Z # Substitute environment variables in install-dir input
2026-11-26T14:15:37.2494837Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:15:37.2495194Z 
2026-11-26T14:15:37.2495521Z # cosign install script
2026-11-26T14:15:37.2495829Z shopt -s expand_aliases
2026-11-26T14:15:37.2496236Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:15:37.2496749Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:15:37.2497201Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:15:37.2497554Z else
2026-11-26T14:15:37.2497848Z   alias log_info="echo \"INFO:\""
2026-11-26T14:15:37.2498245Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:15:37.2498603Z fi
2026-11-26T14:15:37.2498864Z set -e
2026-11-26T14:15:37.2499142Z 
2026-11-26T14:15:37.2499580Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:15:37.2500022Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:15:37.2500534Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:15:37.2501211Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:15:37.2501746Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:15:37.2502215Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:15:37.2502797Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:15:37.2503291Z 
2026-11-26T14:15:37.2503579Z # This function helps compare versions.
2026-11-26T14:15:37.2504061Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:15:37.2504492Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:15:37.2504836Z is_version_ge() {
2026-11-26T14:15:37.2505181Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:15:37.2505536Z }
2026-11-26T14:15:37.2505824Z 
2026-11-26T14:15:37.2506153Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:15:37.2506565Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:15:37.2507007Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:15:37.2507366Z   version_num="${input_cosign_release}"
2026-11-26T14:15:37.2507715Z   version_num="${version_num#v}"
2026-11-26T14:15:37.2508009Z 
2026-11-26T14:15:37.2508344Z   # Check if version is less than v2.0.0
2026-11-26T14:15:37.2508706Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:15:37.2509130Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:15:37.2509619Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:15:37.2510015Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:15:37.2510487Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:15:37.2510929Z     exit 1
2026-11-26T14:15:37.2511491Z   fi
2026-11-26T14:15:37.2511748Z fi
2026-11-26T14:15:37.2512109Z 
2026-11-26T14:15:37.2512411Z mkdir -p "${install_dir}"
2026-11-26T14:15:37.2512728Z 
2026-11-26T14:15:37.2513008Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:15:37.2513442Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:15:37.2513876Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:15:37.2514252Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:15:37.2514777Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:15:37.2515149Z   exit 0
2026-11-26T14:15:37.2515417Z fi
2026-11-26T14:15:37.2515663Z 
2026-11-26T14:15:37.2515948Z shaprog() {
2026-11-26T14:15:37.2516242Z   case ${runner_os} in
2026-11-26T14:15:37.2516550Z     Linux|linux)
2026-11-26T14:15:37.2516857Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:15:37.2517205Z       ;;
2026-11-26T14:15:37.2517473Z     macOS|macos)
2026-11-26T14:15:37.2517787Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:15:37.2518117Z       ;;
2026-11-26T14:15:37.2518408Z     Windows|windows)
2026-11-26T14:15:37.2518893Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:15:37.2519381Z       ;;
2026-11-26T14:15:37.2519694Z     *)
2026-11-26T14:15:37.2520008Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:15:37.2520350Z       exit 1
2026-11-26T14:15:37.2520642Z       ;;
2026-11-26T14:15:37.2520906Z   esac
2026-11-26T14:15:37.2521349Z }
2026-11-26T14:15:37.2521620Z 
