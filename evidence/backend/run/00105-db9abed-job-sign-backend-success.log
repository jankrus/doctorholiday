2026-11-26T14:15:37.2528318Z bootstrap_linux_s390x_sha="777978d576af893a3daf1fcf3b0e9178cebcbc083a669f6125b6c97b8e1fe433"
2026-11-26T14:15:37.2528952Z bootstrap_windows_amd64_sha="cbe953787074611f1334cbf37dc1cf953995bb8c45398eb4fc7bb781d29c1f2a"
2026-11-26T14:15:37.2529381Z 
2026-11-26T14:15:37.2529714Z cosign_executable_name=cosign
2026-11-26T14:15:37.2530049Z bootstrap_executable_name=cosign-bootstrap
2026-11-26T14:15:37.2530443Z 
2026-11-26T14:15:37.2530708Z trap "popd >/dev/null" EXIT
2026-11-26T14:15:37.2531192Z 
2026-11-26T14:15:37.2531572Z pushd "${install_dir}" > /dev/null
2026-11-26T14:15:37.2531881Z 
