2026-11-25T13:50:06.0105349Z ##[group]Run #!/bin/bash
2026-11-25T13:50:06.0106091Z #!/bin/bash
2026-11-25T13:50:06.0106398Z # Substitute environment variables in install-dir input
2026-11-25T13:50:06.0106782Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:50:06.0107083Z 
2026-11-25T13:50:06.0107288Z # cosign install script
2026-11-25T13:50:06.0107722Z shopt -s expand_aliases
2026-11-25T13:50:06.0108028Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:50:06.0108341Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:50:06.0108685Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:50:06.0108975Z else
2026-11-25T13:50:06.0109278Z   alias log_info="echo \"INFO:\""
2026-11-25T13:50:06.0109600Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:50:06.0109866Z fi
2026-11-25T13:50:06.0110068Z set -e
2026-11-25T13:50:06.0110270Z 
2026-11-25T13:50:06.0110500Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:50:06.0110880Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:50:06.0111330Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:50:06.0111778Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:50:06.0112204Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:50:06.0112629Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:50:06.0113130Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:50:06.0113540Z 
2026-11-25T13:50:06.0113773Z # This function helps compare versions.
2026-11-25T13:50:06.0114279Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:50:06.0114624Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:50:06.0114903Z is_version_ge() {
2026-11-25T13:50:06.0115192Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:50:06.0115493Z }
2026-11-25T13:50:06.0115688Z 
2026-11-25T13:50:06.0115969Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:50:06.0116337Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:50:06.0116688Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:50:06.0117015Z   version_num="${input_cosign_release}"
2026-11-25T13:50:06.0117295Z   version_num="${version_num#v}"
2026-11-25T13:50:06.0117686Z 
2026-11-25T13:50:06.0117909Z   # Check if version is less than v2.0.0
2026-11-25T13:50:06.0118223Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:50:06.0118603Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:50:06.0119009Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:50:06.0119365Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:50:06.0119797Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:50:06.0120191Z     exit 1
2026-11-25T13:50:06.0120403Z   fi
2026-11-25T13:50:06.0120601Z fi
2026-11-25T13:50:06.0120966Z 
2026-11-25T13:50:06.0121189Z mkdir -p "${install_dir}"
2026-11-25T13:50:06.0121439Z 
2026-11-25T13:50:06.0121669Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:50:06.0122046Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:50:06.0122396Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:50:06.0122712Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:50:06.0123065Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:50:06.0123342Z   exit 0
2026-11-25T13:50:06.0123538Z fi
2026-11-25T13:50:06.0123729Z 
2026-11-25T13:50:06.0123918Z shaprog() {
2026-11-25T13:50:06.0124137Z   case ${runner_os} in
2026-11-25T13:50:06.0124386Z     Linux|linux)
2026-11-25T13:50:06.0124643Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:50:06.0124909Z       ;;
2026-11-25T13:50:06.0125122Z     macOS|macos)
2026-11-25T13:50:06.0125368Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:50:06.0125637Z       ;;
2026-11-25T13:50:06.0125844Z     Windows|windows)
2026-11-25T13:50:06.0126288Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:50:06.0126731Z       ;;
2026-11-25T13:50:06.0126922Z     *)
2026-11-25T13:50:06.0127169Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:50:06.0127442Z       exit 1
2026-11-25T13:50:06.0127825Z       ;;
2026-11-25T13:50:06.0128025Z   esac
2026-11-25T13:50:06.0128220Z }
