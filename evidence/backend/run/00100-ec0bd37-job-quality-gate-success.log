2026-11-25T13:50:06.0159589Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-25T13:50:06.0160242Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
