2026-11-26T14:16:51.8296326Z shopt -s expand_aliases
2026-11-26T14:16:51.8297138Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:16:51.8297982Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:16:51.8298889Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:16:51.8299695Z else
2026-11-26T14:16:51.8300423Z   alias log_info="echo \"INFO:\""
2026-11-26T14:16:51.8301261Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:16:51.8302027Z fi
2026-11-26T14:16:51.8302700Z set -e
2026-11-26T14:16:51.8303390Z 
2026-11-26T14:16:51.8304348Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:16:51.8305285Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:16:51.8306296Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:16:51.8307297Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:16:51.8308300Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:16:51.8309312Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:16:51.8310400Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:16:51.8311328Z 
2026-11-26T14:16:51.8312051Z # This function helps compare versions.
2026-11-26T14:16:51.8312901Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:16:51.8313839Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:16:51.8314637Z is_version_ge() {
2026-11-26T14:16:51.8315462Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:16:51.8316280Z }
2026-11-26T14:16:51.8316968Z 
2026-11-26T14:16:51.8317750Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:16:51.8318872Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:16:51.8319756Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:16:51.8320597Z   version_num="${input_cosign_release}"
2026-11-26T14:16:51.8321398Z   version_num="${version_num#v}"
2026-11-26T14:16:51.8322139Z 
2026-11-26T14:16:51.8322849Z   # Check if version is less than v2.0.0
2026-11-26T14:16:51.8323773Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:16:51.8324690Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:16:51.8325623Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:16:51.8326498Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:16:51.8327482Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:16:51.8328385Z     exit 1
2026-11-26T14:16:51.8329074Z   fi
2026-11-26T14:16:51.8329743Z fi
2026-11-26T14:16:51.8330618Z 
2026-11-26T14:16:51.8331321Z mkdir -p "${install_dir}"
2026-11-26T14:16:51.8332047Z 
2026-11-26T14:16:51.8332786Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:16:51.8333800Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:16:51.8334671Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:16:51.8335512Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:16:51.8336425Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:16:51.8337253Z   exit 0
2026-11-26T14:16:51.8337936Z fi
2026-11-26T14:16:51.8358837Z 
2026-11-26T14:16:51.8359585Z shaprog() {
2026-11-26T14:16:51.8360329Z   case ${runner_os} in
2026-11-26T14:16:51.8361091Z     Linux|linux)
2026-11-26T14:16:51.8361865Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:16:51.8362642Z       ;;
2026-11-26T14:16:51.8363343Z     macOS|macos)
2026-11-26T14:16:51.8364196Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:16:51.8364967Z       ;;
2026-11-26T14:16:51.8365668Z     Windows|windows)
2026-11-26T14:16:51.8366670Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:16:51.8367647Z       ;;
2026-11-26T14:16:51.8368393Z     *)
2026-11-26T14:16:51.8369159Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:16:51.8369946Z       exit 1
2026-11-26T14:16:51.8370632Z       ;;
2026-11-26T14:16:51.8371324Z   esac
2026-11-26T14:16:51.8371994Z }
2026-11-26T14:16:51.8372664Z 
