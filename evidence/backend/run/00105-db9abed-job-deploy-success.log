2026-11-26T14:16:51.8445697Z 
2026-11-26T14:16:51.8446340Z SUDO=
2026-11-26T14:16:51.8447102Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T14:16:51.8447910Z   SUDO=sudo
2026-11-26T14:16:51.8448577Z fi
2026-11-26T14:16:51.8449209Z 
2026-11-26T14:16:51.8449936Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T14:16:51.8451260Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T14:16:51.8452949Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T14:16:51.8454221Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T14:16:51.8455128Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
2026-11-26T14:16:51.8456085Z   log_error "Unable to validate cosign version: '${input_cosign_release}'"
2026-11-26T14:16:51.8456907Z   exit 1
2026-11-26T14:16:51.8457556Z fi
2026-11-26T14:16:51.8458268Z $SUDO chmod +x "${bootstrap_executable_name}"
2026-11-26T14:16:51.8459024Z 
2026-11-26T14:16:51.8459849Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T14:16:51.8460807Z if [[ "${input_cosign_release}" == "${bootstrap_version}" ]]; then
2026-11-26T14:16:51.8461858Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T14:16:51.8462904Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
2026-11-26T14:16:51.8463785Z   exit 0
2026-11-26T14:16:51.8464442Z fi
2026-11-26T14:16:51.8465089Z 
2026-11-26T14:16:51.8465804Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T14:16:51.8466646Z if [[ "${input_cosign_release}" =~ $semver ]]; then
2026-11-26T14:16:51.8467549Z   log_info "Custom cosign version '${input_cosign_release}' requested"
2026-11-26T14:16:51.8468362Z else
2026-11-26T14:16:51.8469187Z   log_error "Unable to validate requested cosign version: '${input_cosign_release}'"
2026-11-26T14:16:51.8470035Z   exit 1
2026-11-26T14:16:51.8470703Z fi
2026-11-26T14:16:51.8471338Z 
2026-11-26T14:16:51.8471999Z # Download custom cosign
2026-11-26T14:16:51.8473353Z log_info "Downloading platform-specific version '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}"
2026-11-26T14:16:51.8475065Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T14:16:51.8476306Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
2026-11-26T14:16:51.8477100Z 
2026-11-26T14:16:51.8477804Z # same hash means it is the same release
2026-11-26T14:16:51.8478610Z if [[ "$shaCustom" != "$shaBootstrap" ]]; then
2026-11-26T14:16:51.8479831Z   log_info "Downloading cosign public key '${input_cosign_release}' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub"
2026-11-26T14:16:51.8481392Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub
2026-11-26T14:16:51.8482579Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T14:16:51.8483462Z 
2026-11-26T14:16:51.8484273Z   log_info "Verifying public key matches expected value"
2026-11-26T14:16:51.8485223Z   $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "$RELEASE_COSIGN_PUB_KEY" -o public.key
2026-11-26T14:16:51.8486115Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T14:16:51.8486968Z   if [[ "$sha_fetched_key" != "$RELEASE_COSIGN_PUB_KEY_SHA" ]]; then
2026-11-26T14:16:51.8487885Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T14:16:51.8488702Z     exit 1
2026-11-26T14:16:51.8489373Z   fi
2026-11-26T14:16:51.8490022Z 
2026-11-26T14:16:51.8490739Z   if is_version_ge "3.0.1" "$version_num"; then
2026-11-26T14:16:51.8491615Z     # we're trying to get something greater than or equal to v3.0.1
2026-11-26T14:16:51.8492540Z     keyless_signature_file=${desired_cosign_filename}.sigstore.json
2026-11-26T14:16:51.8494012Z     log_info "Downloading keyless verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T14:16:51.8495650Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T14:16:51.8496688Z 
2026-11-26T14:16:51.8497517Z     log_info "Using bootstrap cosign to verify keyless signature of desired cosign version"
2026-11-26T14:16:51.8499053Z     "./${bootstrap_executable_name}" verify-blob --certificate-identity=keyless@projectsigstore.iam.gserviceaccount.com --certificate-oidc-issuer=https://accounts.google.com --bundle "${keyless_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:16:51.8500379Z 
2026-11-26T14:16:51.8501107Z     if is_version_ge "3.0.3" "$version_num"; then
2026-11-26T14:16:51.8501971Z       # we're trying to get something greater than or equal to v3.0.3
2026-11-26T14:16:51.8502886Z       kms_signature_file=${desired_cosign_filename}-kms.sigstore.json
2026-11-26T14:16:51.8504308Z       log_info "Downloading KMS verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T14:16:51.8505856Z       $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T14:16:51.8506863Z 
2026-11-26T14:16:51.8507810Z       log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T14:16:51.8508968Z       "./${bootstrap_executable_name}" verify-blob --key public.key --bundle "${kms_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:16:51.8509923Z     fi
2026-11-26T14:16:51.8510579Z   else
2026-11-26T14:16:51.8511309Z     signature_file=${desired_cosign_filename}.sig
2026-11-26T14:16:51.8512571Z     log_info "Downloading detached signature for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T14:16:51.8514147Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T14:16:51.8515141Z 
2026-11-26T14:16:51.8515958Z     log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T14:16:51.8517211Z     "./${bootstrap_executable_name}" verify-blob --key public.key --signature "${signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:16:51.8518189Z   fi
2026-11-26T14:16:51.8518839Z 
2026-11-26T14:16:51.8519609Z   $SUDO mv "cosign_${input_cosign_release}" "${cosign_executable_name}"
2026-11-26T14:16:51.8520473Z   $SUDO chmod +x "${cosign_executable_name}"
2026-11-26T14:16:51.8521378Z   # best-effort: on Windows the just-run bootstrap binary may still be locked briefly
