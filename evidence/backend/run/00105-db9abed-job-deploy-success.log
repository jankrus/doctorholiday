2026-11-26T14:16:51.8421288Z       ARM64|arm64)
2026-11-26T14:16:51.8422044Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T14:16:51.8422866Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T14:16:51.8423798Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T14:16:51.8424565Z         ;;
2026-11-26T14:16:51.8425239Z 
2026-11-26T14:16:51.8425868Z       *)
