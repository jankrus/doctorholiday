2026-11-25T13:52:40.5166294Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:52:40.5166786Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:52:40.5167215Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
