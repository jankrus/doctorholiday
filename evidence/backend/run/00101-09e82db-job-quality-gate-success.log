2026-11-25T13:52:40.5143804Z #!/bin/bash
2026-11-25T13:52:40.5144177Z # Substitute environment variables in install-dir input
2026-11-25T13:52:40.5144611Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:52:40.5145373Z 
2026-11-25T13:52:40.5145701Z # cosign install script
2026-11-25T13:52:40.5146041Z shopt -s expand_aliases
2026-11-25T13:52:40.5146470Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:52:40.5146867Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:52:40.5147279Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:52:40.5147680Z else
2026-11-25T13:52:40.5148036Z   alias log_info="echo \"INFO:\""
2026-11-25T13:52:40.5148400Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:52:40.5148746Z fi
2026-11-25T13:52:40.5149035Z set -e
2026-11-25T13:52:40.5149331Z 
2026-11-25T13:52:40.5149614Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:52:40.5150065Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:52:40.5150578Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:52:40.5151109Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:52:40.5151586Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:52:40.5152087Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:52:40.5152682Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:52:40.5153158Z 
2026-11-25T13:52:40.5153453Z # This function helps compare versions.
2026-11-25T13:52:40.5154137Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:52:40.5154632Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:52:40.5155183Z is_version_ge() {
2026-11-25T13:52:40.5155634Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:52:40.5156100Z }
2026-11-25T13:52:40.5156481Z 
2026-11-25T13:52:40.5157188Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:52:40.5157840Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:52:40.5158385Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:52:40.5158864Z   version_num="${input_cosign_release}"
2026-11-25T13:52:40.5159229Z   version_num="${version_num#v}"
2026-11-25T13:52:40.5159549Z 
2026-11-25T13:52:40.5159903Z   # Check if version is less than v2.0.0
2026-11-25T13:52:40.5160305Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:52:40.5160803Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:52:40.5161369Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:52:40.5161792Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:52:40.5162275Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:52:40.5162738Z     exit 1
2026-11-25T13:52:40.5163060Z   fi
2026-11-25T13:52:40.5163347Z fi
2026-11-25T13:52:40.5163779Z 
2026-11-25T13:52:40.5164080Z mkdir -p "${install_dir}"
2026-11-25T13:52:40.5164449Z 
