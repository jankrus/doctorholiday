2026-11-25T13:44:28.6065081Z #!/bin/bash
2026-11-25T13:44:28.6065377Z # Substitute environment variables in install-dir input
2026-11-25T13:44:28.6065784Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:44:28.6066070Z 
2026-11-25T13:44:28.6066310Z # cosign install script
2026-11-25T13:44:28.6066793Z shopt -s expand_aliases
2026-11-25T13:44:28.6067157Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:44:28.6067433Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:44:28.6067739Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:44:28.6068046Z else
2026-11-25T13:44:28.6068267Z   alias log_info="echo \"INFO:\""
2026-11-25T13:44:28.6068534Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:44:28.6068807Z fi
2026-11-25T13:44:28.6068983Z set -e
2026-11-25T13:44:28.6069208Z 
2026-11-25T13:44:28.6069421Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:44:28.6069764Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:44:28.6070176Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:44:28.6070577Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:44:28.6070996Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:44:28.6071411Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:44:28.6071878Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:44:28.6072255Z 
2026-11-25T13:44:28.6072469Z # This function helps compare versions.
2026-11-25T13:44:28.6072795Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:44:28.6073097Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:44:28.6073353Z is_version_ge() {
2026-11-25T13:44:28.6073669Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:44:28.6073962Z }
2026-11-25T13:44:28.6074159Z 
2026-11-25T13:44:28.6074413Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:44:28.6074744Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:44:28.6075226Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:44:28.6075547Z   version_num="${input_cosign_release}"
2026-11-25T13:44:28.6075818Z   version_num="${version_num#v}"
2026-11-25T13:44:28.6076113Z 
2026-11-25T13:44:28.6076361Z   # Check if version is less than v2.0.0
2026-11-25T13:44:28.6076989Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:44:28.6077368Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:44:28.6077734Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:44:28.6078087Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:44:28.6078467Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:44:28.6078841Z     exit 1
2026-11-25T13:44:28.6079060Z   fi
2026-11-25T13:44:28.6079255Z fi
2026-11-25T13:44:28.6079532Z 
2026-11-25T13:44:28.6079733Z mkdir -p "${install_dir}"
2026-11-25T13:44:28.6079976Z 
2026-11-25T13:44:28.6080216Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:44:28.6080581Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:44:28.6080925Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:44:28.6081210Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:44:28.6081538Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:44:28.6081811Z   exit 0
2026-11-25T13:44:28.6081990Z fi
2026-11-25T13:44:28.6082189Z 
2026-11-25T13:44:28.6082375Z shaprog() {
2026-11-25T13:44:28.6082633Z   case ${runner_os} in
2026-11-25T13:44:28.6082858Z     Linux|linux)
2026-11-25T13:44:28.6083080Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:44:28.6083338Z       ;;
2026-11-25T13:44:28.6083539Z     macOS|macos)
2026-11-25T13:44:28.6083775Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:44:28.6084046Z       ;;
2026-11-25T13:44:28.6084245Z     Windows|windows)
2026-11-25T13:44:28.6084730Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:44:28.6085129Z       ;;
2026-11-25T13:44:28.6085317Z     *)
2026-11-25T13:44:28.6085569Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:44:28.6085826Z       exit 1
2026-11-25T13:44:28.6086036Z       ;;
2026-11-25T13:44:28.6086231Z   esac
2026-11-25T13:44:28.6086412Z }
