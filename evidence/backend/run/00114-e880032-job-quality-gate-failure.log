2026-11-26T16:03:05.6393916Z ##[group]Run #!/bin/bash
2026-11-26T16:03:05.6394852Z #!/bin/bash
2026-11-26T16:03:05.6395200Z # Substitute environment variables in install-dir input
2026-11-26T16:03:05.6395571Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T16:03:05.6396192Z 
2026-11-26T16:03:05.6396461Z # cosign install script
2026-11-26T16:03:05.6396746Z shopt -s expand_aliases
2026-11-26T16:03:05.6397129Z if [ -z "$NO_COLOR" ]; then
2026-11-26T16:03:05.6397484Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T16:03:05.6397840Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T16:03:05.6398165Z else
2026-11-26T16:03:05.6398413Z   alias log_info="echo \"INFO:\""
2026-11-26T16:03:05.6398737Z   alias log_error="echo \"ERROR:\""
2026-11-26T16:03:05.6399023Z fi
2026-11-26T16:03:05.6399258Z set -e
2026-11-26T16:03:05.6399481Z 
2026-11-26T16:03:05.6399760Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T16:03:05.6400169Z # Retry options shared by every release download below. GitHub's release
2026-11-26T16:03:05.6400605Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T16:03:05.6401054Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T16:03:05.6401486Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T16:03:05.6401938Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T16:03:05.6402453Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T16:03:05.6403004Z 
2026-11-26T16:03:05.6403274Z # This function helps compare versions.
2026-11-26T16:03:05.6403615Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T16:03:05.6403973Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T16:03:05.6404257Z is_version_ge() {
2026-11-26T16:03:05.6404578Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T16:03:05.6404899Z }
2026-11-26T16:03:05.6405117Z 
2026-11-26T16:03:05.6405411Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T16:03:05.6405961Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T16:03:05.6406377Z   # Extract version without 'v' prefix for comparison
2026-11-26T16:03:05.6406695Z   version_num="${input_cosign_release}"
2026-11-26T16:03:05.6407070Z   version_num="${version_num#v}"
2026-11-26T16:03:05.6407332Z 
2026-11-26T16:03:05.6407597Z   # Check if version is less than v2.0.0
2026-11-26T16:03:05.6407934Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T16:03:05.6408316Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T16:03:05.6408727Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T16:03:05.6409096Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T16:03:05.6409562Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T16:03:05.6409938Z     exit 1
2026-11-26T16:03:05.6410189Z   fi
2026-11-26T16:03:05.6410398Z fi
2026-11-26T16:03:05.6410756Z 
2026-11-26T16:03:05.6410985Z mkdir -p "${install_dir}"
2026-11-26T16:03:05.6411251Z 
2026-11-26T16:03:05.6411523Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T16:03:05.6411923Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T16:03:05.6412301Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T16:03:05.6412644Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T16:03:05.6413036Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T16:03:05.6413320Z   exit 0
2026-11-26T16:03:05.6413617Z fi
2026-11-26T16:03:05.6413838Z 
2026-11-26T16:03:05.6414061Z shaprog() {
2026-11-26T16:03:05.6414314Z   case ${runner_os} in
2026-11-26T16:03:05.6414611Z     Linux|linux)
2026-11-26T16:03:05.6414908Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T16:03:05.6415191Z       ;;
2026-11-26T16:03:05.6415451Z     macOS|macos)
2026-11-26T16:03:05.6415707Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T16:03:05.6416180Z       ;;
2026-11-26T16:03:05.6416420Z     Windows|windows)
2026-11-26T16:03:05.6416863Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T16:03:05.6417327Z       ;;
2026-11-26T16:03:05.6417584Z     *)
2026-11-26T16:03:05.6417939Z       log_error "unsupported OS ${runner_os}"
2026-11-26T16:03:05.6418312Z       exit 1
2026-11-26T16:03:05.6418542Z       ;;
2026-11-26T16:03:05.6418784Z   esac
2026-11-26T16:03:05.6419037Z }
2026-11-26T16:03:05.6419255Z 
2026-11-26T16:03:05.6419628Z ## curl -sL https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign_checksums.txt |\
2026-11-26T16:03:05.6420237Z ##   gawk 'match($2,/^cosign-([[:alnum:]]+)-([[:alnum:]]+)(\.[[:alnum:]]+)?$/,a){printf "bootstrap_%s_%s_sha=\"%s\"\n",a[1],a[2],$1}' |\
2026-11-26T16:03:05.6420713Z ##   LANG=C sort
2026-11-26T16:03:05.6420969Z bootstrap_version='v3.1.4'
2026-11-26T16:03:05.6421409Z bootstrap_darwin_amd64_sha="9d1e4abe2b6be279ed0d2ff706fde1ccd738747c834e3e6d44039c238867334f"
2026-11-26T16:03:05.6422079Z bootstrap_darwin_arm64_sha="9f9b8cd557cf2e5b3df3373a00baa005a86b02391e3e06dd0ce37b3a1533d3a4"
2026-11-26T16:03:05.6422636Z bootstrap_linux_amd64_sha="424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa"
2026-11-26T16:03:05.6423203Z bootstrap_linux_arm64_sha="ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2"
2026-11-26T16:03:05.6423742Z bootstrap_linux_arm_sha="09e77a313910cf5c4774508d85d017d9c60983f41bf657f83ecbd3892f7952cb"
2026-11-26T16:03:05.6424289Z bootstrap_linux_ppc64le_sha="0887fca23319ea017cc827e6a845ba83722a36bf9e932f35c747ca83c14cec49"
2026-11-26T16:03:05.6424896Z bootstrap_linux_riscv64_sha="24f3865df0fd9b055827b888d56e13583112ac7d4c87b45967af1f0febf35455"
2026-11-26T16:03:05.6425427Z bootstrap_linux_s390x_sha="777978d576af893a3daf1fcf3b0e9178cebcbc083a669f6125b6c97b8e1fe433"
2026-11-26T16:03:05.6426145Z bootstrap_windows_amd64_sha="cbe953787074611f1334cbf37dc1cf953995bb8c45398eb4fc7bb781d29c1f2a"
2026-11-26T16:03:05.6426537Z 
2026-11-26T16:03:05.6426798Z cosign_executable_name=cosign
2026-11-26T16:03:05.6427116Z bootstrap_executable_name=cosign-bootstrap
2026-11-26T16:03:05.6427419Z 
2026-11-26T16:03:05.6427646Z trap "popd >/dev/null" EXIT
2026-11-26T16:03:05.6427913Z 
2026-11-26T16:03:05.6428200Z pushd "${install_dir}" > /dev/null
2026-11-26T16:03:05.6428459Z 
2026-11-26T16:03:05.6428768Z case ${runner_os} in
2026-11-26T16:03:05.6429036Z   Linux|linux)
2026-11-26T16:03:05.6429445Z     case ${runner_arch} in
2026-11-26T16:03:05.6429730Z       X64|amd64)
2026-11-26T16:03:05.6430061Z         bootstrap_filename='cosign-linux-amd64'
2026-11-26T16:03:05.6430427Z         bootstrap_sha=${bootstrap_linux_amd64_sha}
2026-11-26T16:03:05.6430800Z         desired_cosign_filename='cosign-linux-amd64'
2026-11-26T16:03:05.6431161Z         ;;
2026-11-26T16:03:05.6431431Z 
2026-11-26T16:03:05.6431668Z       ARM|arm)
2026-11-26T16:03:05.6431992Z         bootstrap_filename='cosign-linux-arm'
2026-11-26T16:03:05.6432388Z         bootstrap_sha=${bootstrap_linux_arm_sha}
2026-11-26T16:03:05.6432740Z         desired_cosign_filename='cosign-linux-arm'
2026-11-26T16:03:05.6433074Z         ;;
2026-11-26T16:03:05.6433320Z 
2026-11-26T16:03:05.6433581Z       ARM64|arm64)
2026-11-26T16:03:05.6433904Z         bootstrap_filename='cosign-linux-arm64'
2026-11-26T16:03:05.6434281Z         bootstrap_sha=${bootstrap_linux_arm64_sha}
2026-11-26T16:03:05.6434650Z         desired_cosign_filename='cosign-linux-arm64'
2026-11-26T16:03:05.6434994Z         ;;
2026-11-26T16:03:05.6435245Z 
2026-11-26T16:03:05.6435511Z       *)
2026-11-26T16:03:05.6436023Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T16:03:05.6436389Z         exit 1
2026-11-26T16:03:05.6436674Z         ;;
2026-11-26T16:03:05.6436939Z     esac
2026-11-26T16:03:05.6437200Z     ;;
2026-11-26T16:03:05.6437440Z 
2026-11-26T16:03:05.6437710Z   macOS|macos)
2026-11-26T16:03:05.6438215Z     case ${runner_arch} in
2026-11-26T16:03:05.6438544Z       X64|amd64)
2026-11-26T16:03:05.6438826Z         bootstrap_filename='cosign-darwin-amd64'
2026-11-26T16:03:05.6439271Z         bootstrap_sha=${bootstrap_darwin_amd64_sha}
2026-11-26T16:03:05.6439633Z         desired_cosign_filename='cosign-darwin-amd64'
2026-11-26T16:03:05.6439957Z         ;;
2026-11-26T16:03:05.6440171Z 
2026-11-26T16:03:05.6440418Z       ARM64|arm64)
2026-11-26T16:03:05.6440736Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T16:03:05.6441136Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T16:03:05.6441505Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T16:03:05.6441787Z         ;;
2026-11-26T16:03:05.6442066Z 
2026-11-26T16:03:05.6442268Z       *)
2026-11-26T16:03:05.6442573Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T16:03:05.6442876Z         exit 1
2026-11-26T16:03:05.6443154Z         ;;
2026-11-26T16:03:05.6443366Z     esac
2026-11-26T16:03:05.6443604Z     ;;
2026-11-26T16:03:05.6443820Z 
2026-11-26T16:03:05.6444046Z   Windows|windows)
2026-11-26T16:03:05.6444356Z     case ${runner_arch} in
2026-11-26T16:03:05.6444611Z       X64|amd64)
2026-11-26T16:03:05.6444925Z         bootstrap_filename='cosign-windows-amd64.exe'
2026-11-26T16:03:05.6445260Z         bootstrap_sha=${bootstrap_windows_amd64_sha}
2026-11-26T16:03:05.6445663Z         desired_cosign_filename='cosign-windows-amd64.exe'
2026-11-26T16:03:05.6446155Z         cosign_executable_name=cosign.exe
2026-11-26T16:03:05.6446520Z         bootstrap_executable_name=cosign-bootstrap.exe
2026-11-26T16:03:05.6446822Z         ;;
2026-11-26T16:03:05.6447055Z       *)
2026-11-26T16:03:05.6447364Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T16:03:05.6447696Z         exit 1
2026-11-26T16:03:05.6447954Z         ;;
2026-11-26T16:03:05.6448168Z     esac
2026-11-26T16:03:05.6448429Z     ;;
2026-11-26T16:03:05.6448711Z   *)
2026-11-26T16:03:05.6448985Z     log_error "unsupported os ${runner_os}"
2026-11-26T16:03:05.6449273Z     exit 1
2026-11-26T16:03:05.6449563Z     ;;
2026-11-26T16:03:05.6449795Z esac
2026-11-26T16:03:05.6450032Z 
2026-11-26T16:03:05.6450240Z SUDO=
2026-11-26T16:03:05.6450584Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T16:03:05.6450922Z   SUDO=sudo
2026-11-26T16:03:05.6451169Z fi
2026-11-26T16:03:05.6451362Z 
2026-11-26T16:03:05.6451667Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T16:03:05.6452419Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T16:03:05.6453454Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T16:03:05.6454099Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T16:03:05.6454528Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
2026-11-26T16:03:05.6454975Z   log_error "Unable to validate cosign version: '${input_cosign_release}'"
2026-11-26T16:03:05.6455347Z   exit 1
2026-11-26T16:03:05.6455557Z fi
2026-11-26T16:03:05.6455977Z $SUDO chmod +x "${bootstrap_executable_name}"
2026-11-26T16:03:05.6456269Z 
2026-11-26T16:03:05.6456606Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T16:03:05.6457051Z if [[ "${input_cosign_release}" == "${bootstrap_version}" ]]; then
2026-11-26T16:03:05.6457639Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T16:03:05.6458270Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
2026-11-26T16:03:05.6458644Z   exit 0
2026-11-26T16:03:05.6458870Z fi
2026-11-26T16:03:05.6459096Z 
2026-11-26T16:03:05.6459439Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T16:03:05.6459832Z if [[ "${input_cosign_release}" =~ $semver ]]; then
2026-11-26T16:03:05.6460192Z   log_info "Custom cosign version '${input_cosign_release}' requested"
2026-11-26T16:03:05.6460576Z else
2026-11-26T16:03:05.6460964Z   log_error "Unable to validate requested cosign version: '${input_cosign_release}'"
2026-11-26T16:03:05.6461368Z   exit 1
2026-11-26T16:03:05.6461604Z fi
2026-11-26T16:03:05.6461818Z 
2026-11-26T16:03:05.6462061Z # Download custom cosign
2026-11-26T16:03:05.6462717Z log_info "Downloading platform-specific version '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}"
2026-11-26T16:03:05.6463727Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T16:03:05.6464405Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
2026-11-26T16:03:05.6464715Z 
2026-11-26T16:03:05.6464964Z # same hash means it is the same release
2026-11-26T16:03:05.6465318Z if [[ "$shaCustom" != "$shaBootstrap" ]]; then
2026-11-26T16:03:05.6466096Z   log_info "Downloading cosign public key '${input_cosign_release}' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub"
2026-11-26T16:03:05.6467014Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub
2026-11-26T16:03:05.6467635Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T16:03:05.6468081Z 
2026-11-26T16:03:05.6468350Z   log_info "Verifying public key matches expected value"
2026-11-26T16:03:05.6468796Z   $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "$RELEASE_COSIGN_PUB_KEY" -o public.key
2026-11-26T16:03:05.6469188Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T16:03:05.6469566Z   if [[ "$sha_fetched_key" != "$RELEASE_COSIGN_PUB_KEY_SHA" ]]; then
2026-11-26T16:03:05.6470013Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T16:03:05.6470355Z     exit 1
2026-11-26T16:03:05.6470612Z   fi
2026-11-26T16:03:05.6470820Z 
2026-11-26T16:03:05.6471111Z   if is_version_ge "3.0.1" "$version_num"; then
2026-11-26T16:03:05.6471517Z     # we're trying to get something greater than or equal to v3.0.1
2026-11-26T16:03:05.6471944Z     keyless_signature_file=${desired_cosign_filename}.sigstore.json
2026-11-26T16:03:05.6472739Z     log_info "Downloading keyless verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T16:03:05.6473697Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T16:03:05.6474239Z 
2026-11-26T16:03:05.6474569Z     log_info "Using bootstrap cosign to verify keyless signature of desired cosign version"
2026-11-26T16:03:05.6475501Z     "./${bootstrap_executable_name}" verify-blob --certificate-identity=keyless@projectsigstore.iam.gserviceaccount.com --certificate-oidc-issuer=https://accounts.google.com --bundle "${keyless_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T16:03:05.6476488Z 
2026-11-26T16:03:05.6476758Z     if is_version_ge "3.0.3" "$version_num"; then
2026-11-26T16:03:05.6477136Z       # we're trying to get something greater than or equal to v3.0.3
2026-11-26T16:03:05.6477595Z       kms_signature_file=${desired_cosign_filename}-kms.sigstore.json
2026-11-26T16:03:05.6478382Z       log_info "Downloading KMS verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T16:03:05.6479310Z       $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T16:03:05.6479803Z 
2026-11-26T16:03:05.6480132Z       log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T16:03:05.6480725Z       "./${bootstrap_executable_name}" verify-blob --key public.key --bundle "${kms_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T16:03:05.6481225Z     fi
2026-11-26T16:03:05.6481467Z   else
2026-11-26T16:03:05.6481787Z     signature_file=${desired_cosign_filename}.sig
2026-11-26T16:03:05.6482527Z     log_info "Downloading detached signature for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T16:03:05.6483432Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T16:03:05.6483965Z 
2026-11-26T16:03:05.6484343Z     log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T16:03:05.6484979Z     "./${bootstrap_executable_name}" verify-blob --key public.key --signature "${signature_file}" "cosign_${input_cosign_release}"
2026-11-26T16:03:05.6485531Z   fi
