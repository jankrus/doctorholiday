2026-11-25T13:49:32.2015457Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:49:32.2015790Z       ;;
2026-11-25T13:49:32.2016057Z     macOS|macos)
2026-11-25T13:49:32.2016414Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:49:32.2016740Z       ;;
2026-11-25T13:49:32.2017044Z     Windows|windows)
2026-11-25T13:49:32.2017509Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:49:32.2018028Z       ;;
2026-11-25T13:49:32.2018298Z     *)
2026-11-25T13:49:32.2018617Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:49:32.2018948Z       exit 1
2026-11-25T13:49:32.2019245Z       ;;
2026-11-25T13:49:32.2019521Z   esac
2026-11-25T13:49:32.2019778Z }
