2026-11-25T13:49:32.1968852Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-25T13:49:32.1991955Z ##[group]Run #!/bin/bash
2026-11-25T13:49:32.1993178Z #!/bin/bash
2026-11-25T13:49:32.1993560Z # Substitute environment variables in install-dir input
2026-11-25T13:49:32.1993965Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:49:32.1994370Z 
2026-11-25T13:49:32.1994637Z # cosign install script
2026-11-25T13:49:32.1995007Z shopt -s expand_aliases
2026-11-25T13:49:32.1995451Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:49:32.1995817Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:49:32.1996236Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:49:32.1996557Z else
2026-11-25T13:49:32.1996879Z   alias log_info="echo \"INFO:\""
2026-11-25T13:49:32.1997239Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:49:32.1997563Z fi
2026-11-25T13:49:32.1997817Z set -e
2026-11-25T13:49:32.1998095Z 
2026-11-25T13:49:32.1998405Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:49:32.1998818Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:49:32.1999309Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:49:32.1999819Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:49:32.2000284Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:49:32.2000746Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:49:32.2001340Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:49:32.2001773Z 
2026-11-25T13:49:32.2002073Z # This function helps compare versions.
2026-11-25T13:49:32.2002541Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:49:32.2003131Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:49:32.2003478Z is_version_ge() {
2026-11-25T13:49:32.2003827Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:49:32.2004223Z }
2026-11-25T13:49:32.2004471Z 
2026-11-25T13:49:32.2004799Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:49:32.2005204Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:49:32.2005649Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:49:32.2006100Z   version_num="${input_cosign_release}"
2026-11-25T13:49:32.2006440Z   version_num="${version_num#v}"
2026-11-25T13:49:32.2006771Z 
2026-11-25T13:49:32.2007067Z   # Check if version is less than v2.0.0
2026-11-25T13:49:32.2007416Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:49:32.2007845Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:49:32.2008321Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:49:32.2008719Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:49:32.2009175Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:49:32.2009627Z     exit 1
2026-11-25T13:49:32.2009915Z   fi
2026-11-25T13:49:32.2010169Z fi
2026-11-25T13:49:32.2010517Z 
2026-11-25T13:49:32.2010832Z mkdir -p "${install_dir}"
2026-11-25T13:49:32.2011139Z 
2026-11-25T13:49:32.2011431Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:49:32.2011886Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:49:32.2012287Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:49:32.2012674Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:49:32.2013338Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:49:32.2013721Z   exit 0
2026-11-25T13:49:32.2013979Z fi
