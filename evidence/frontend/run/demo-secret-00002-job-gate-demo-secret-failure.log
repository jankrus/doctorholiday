2026-11-25T13:44:21.9184619Z 
2026-11-25T13:44:21.9184852Z # cosign install script
2026-11-25T13:44:21.9185115Z shopt -s expand_aliases
2026-11-25T13:44:21.9185457Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:44:21.9185757Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:44:21.9186090Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:44:21.9186373Z else
2026-11-25T13:44:21.9186620Z   alias log_info="echo \"INFO:\""
2026-11-25T13:44:21.9186895Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:44:21.9187163Z fi
2026-11-25T13:44:21.9187463Z set -e
2026-11-25T13:44:21.9187657Z 
2026-11-25T13:44:21.9187905Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:44:21.9188265Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:44:21.9188684Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:44:21.9189412Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:44:21.9190043Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:44:21.9190499Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:44:21.9191044Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:44:21.9191464Z 
2026-11-25T13:44:21.9191992Z # This function helps compare versions.
2026-11-25T13:44:21.9192318Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:44:21.9192651Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:44:21.9192929Z is_version_ge() {
2026-11-25T13:44:21.9193246Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:44:21.9193565Z }
2026-11-25T13:44:21.9193763Z 
2026-11-25T13:44:21.9194037Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:44:21.9194388Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:44:21.9194868Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:44:21.9195232Z   version_num="${input_cosign_release}"
2026-11-25T13:44:21.9195513Z   version_num="${version_num#v}"
2026-11-25T13:44:21.9195798Z 
2026-11-25T13:44:21.9196019Z   # Check if version is less than v2.0.0
2026-11-25T13:44:21.9196305Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:44:21.9196696Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:44:21.9197070Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:44:21.9197411Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:44:21.9197871Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:44:21.9198291Z     exit 1
2026-11-25T13:44:21.9198541Z   fi
2026-11-25T13:44:21.9198743Z fi
2026-11-25T13:44:21.9199056Z 
2026-11-25T13:44:21.9199280Z mkdir -p "${install_dir}"
2026-11-25T13:44:21.9199522Z 
2026-11-25T13:44:21.9199791Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:44:21.9200147Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:44:21.9200471Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:44:21.9200820Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:44:21.9201273Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:44:21.9201568Z   exit 0
2026-11-25T13:44:21.9201921Z fi
