2026-11-25T13:50:48.7923130Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:50:48.7923779Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:50:48.7924544Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:50:48.7925450Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:50:48.7926216Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:50:48.7926979Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:50:48.7927856Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:50:48.7928550Z 
2026-11-25T13:50:48.7928954Z # This function helps compare versions.
2026-11-25T13:50:48.7950766Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:50:48.7951428Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:50:48.7951950Z is_version_ge() {
2026-11-25T13:50:48.7952495Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:50:48.7953041Z }
2026-11-25T13:50:48.7953379Z 
2026-11-25T13:50:48.7954087Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:50:48.7955391Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:50:48.7956026Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:50:48.7956609Z   version_num="${input_cosign_release}"
2026-11-25T13:50:48.7957116Z   version_num="${version_num#v}"
2026-11-25T13:50:48.7957561Z 
2026-11-25T13:50:48.7957966Z   # Check if version is less than v2.0.0
2026-11-25T13:50:48.7958511Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:50:48.7959159Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:50:48.7959864Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:50:48.7960508Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:50:48.7961247Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:50:48.7961914Z     exit 1
2026-11-25T13:50:48.7962284Z   fi
2026-11-25T13:50:48.7962625Z fi
