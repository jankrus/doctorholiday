2026-11-26T15:36:29.4755595Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:36:29.4755981Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:36:29.4756430Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:36:29.4756765Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:36:29.4757156Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:36:29.4757434Z   exit 0
2026-11-26T15:36:29.4757678Z fi
