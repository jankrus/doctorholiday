2026-11-26T15:36:29.4758185Z shaprog() {
2026-11-26T15:36:29.4758463Z   case ${runner_os} in
2026-11-26T15:36:29.4758721Z     Linux|linux)
2026-11-26T15:36:29.4759002Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:36:29.4759262Z       ;;
2026-11-26T15:36:29.4759506Z     macOS|macos)
2026-11-26T15:36:29.4759772Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:36:29.4760053Z       ;;
2026-11-26T15:36:29.4760270Z     Windows|windows)
2026-11-26T15:36:29.4760748Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:36:29.4761186Z       ;;
2026-11-26T15:36:29.4761421Z     *)
2026-11-26T15:36:29.4761677Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:36:29.4761970Z       exit 1
2026-11-26T15:36:29.4762232Z       ;;
2026-11-26T15:36:29.4762441Z   esac
2026-11-26T15:36:29.4762716Z }
