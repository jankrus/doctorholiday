2026-11-26T15:36:29.4743701Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:36:29.4744134Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:36:29.4744565Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:36:29.4745026Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:36:29.4745449Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:36:29.4745932Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:36:29.4746482Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:36:29.4746876Z 
2026-11-26T15:36:29.4747151Z # This function helps compare versions.
2026-11-26T15:36:29.4747466Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:36:29.4747788Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:36:29.4748128Z is_version_ge() {
2026-11-26T15:36:29.4748411Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:36:29.4748756Z }
2026-11-26T15:36:29.4748956Z 
2026-11-26T15:36:29.4749253Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:36:29.4749804Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:36:29.4750152Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:36:29.4750513Z   version_num="${input_cosign_release}"
2026-11-26T15:36:29.4750806Z   version_num="${version_num#v}"
2026-11-26T15:36:29.4751106Z 
2026-11-26T15:36:29.4751337Z   # Check if version is less than v2.0.0
2026-11-26T15:36:29.4751658Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:36:29.4752047Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:36:29.4752687Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:36:29.4753067Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:36:29.4753632Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:36:29.4754065Z     exit 1
2026-11-26T15:36:29.4754307Z   fi
2026-11-26T15:36:29.4754522Z fi
2026-11-26T15:36:29.4754843Z 
2026-11-26T15:36:29.4755067Z mkdir -p "${install_dir}"
