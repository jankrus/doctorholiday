2026-11-25T13:49:36.0671469Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-25T13:49:36.0693727Z ##[group]Run #!/bin/bash
2026-11-25T13:49:36.0694868Z #!/bin/bash
2026-11-25T13:49:36.0695227Z # Substitute environment variables in install-dir input
2026-11-25T13:49:36.0695663Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:49:36.0696008Z 
2026-11-25T13:49:36.0696323Z # cosign install script
2026-11-25T13:49:36.0696634Z shopt -s expand_aliases
2026-11-25T13:49:36.0697052Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:49:36.0697427Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:49:36.0697867Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:49:36.0698233Z else
2026-11-25T13:49:36.0698526Z   alias log_info="echo \"INFO:\""
2026-11-25T13:49:36.0698889Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:49:36.0699238Z fi
2026-11-25T13:49:36.0699500Z set -e
2026-11-25T13:49:36.0699947Z 
2026-11-25T13:49:36.0700324Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:49:36.0700744Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:49:36.0701302Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:49:36.0701788Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:49:36.0702314Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:49:36.0702785Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:49:36.0703351Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:49:36.0703865Z 
2026-11-25T13:49:36.0704142Z # This function helps compare versions.
2026-11-25T13:49:36.0704636Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:49:36.0705062Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:49:36.0705410Z is_version_ge() {
2026-11-25T13:49:36.0705760Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:49:36.0706125Z }
2026-11-25T13:49:36.0706408Z 
2026-11-25T13:49:36.0706759Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:49:36.0707172Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:49:36.0707631Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:49:36.0708006Z   version_num="${input_cosign_release}"
2026-11-25T13:49:36.0708350Z   version_num="${version_num#v}"
2026-11-25T13:49:36.0708657Z 
2026-11-25T13:49:36.0708982Z   # Check if version is less than v2.0.0
2026-11-25T13:49:36.0709360Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:49:36.0709931Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:49:36.0710459Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:49:36.0710867Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:49:36.0711351Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:49:36.0711842Z     exit 1
2026-11-25T13:49:36.0712145Z   fi
2026-11-25T13:49:36.0712389Z fi
2026-11-25T13:49:36.0712753Z 
2026-11-25T13:49:36.0713064Z mkdir -p "${install_dir}"
2026-11-25T13:49:36.0713377Z 
2026-11-25T13:49:36.0713671Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:49:36.0714109Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:49:36.0714561Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:49:36.0714934Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:49:36.0715464Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:49:36.0715848Z   exit 0
2026-11-25T13:49:36.0716121Z fi
2026-11-25T13:49:36.0716372Z 
2026-11-25T13:49:36.0716667Z shaprog() {
2026-11-25T13:49:36.0716962Z   case ${runner_os} in
2026-11-25T13:49:36.0717286Z     Linux|linux)
2026-11-25T13:49:36.0717577Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:49:36.0717941Z       ;;
2026-11-25T13:49:36.0718225Z     macOS|macos)
2026-11-25T13:49:36.0718536Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:49:36.0718891Z       ;;
2026-11-25T13:49:36.0719175Z     Windows|windows)
2026-11-25T13:49:36.0719676Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:49:36.0720303Z       ;;
2026-11-25T13:49:36.0720620Z     *)
2026-11-25T13:49:36.0720940Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:49:36.0721297Z       exit 1
2026-11-25T13:49:36.0721583Z       ;;
2026-11-25T13:49:36.0721895Z   esac
2026-11-25T13:49:36.0722164Z }
