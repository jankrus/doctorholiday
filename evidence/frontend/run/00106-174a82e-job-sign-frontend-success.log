2026-11-26T15:32:50.8482399Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T15:32:50.8483353Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
