2026-11-26T15:32:50.8416828Z ##[group]Run #!/bin/bash
2026-11-26T15:32:50.8417615Z #!/bin/bash
2026-11-26T15:32:50.8417981Z # Substitute environment variables in install-dir input
2026-11-26T15:32:50.8418441Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:32:50.8418805Z 
2026-11-26T15:32:50.8419049Z # cosign install script
2026-11-26T15:32:50.8419359Z shopt -s expand_aliases
2026-11-26T15:32:50.8419697Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:32:50.8420069Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:32:50.8420500Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:32:50.8420868Z else
2026-11-26T15:32:50.8421137Z   alias log_info="echo \"INFO:\""
2026-11-26T15:32:50.8421474Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:32:50.8421796Z fi
2026-11-26T15:32:50.8422033Z set -e
2026-11-26T15:32:50.8422265Z 
2026-11-26T15:32:50.8422524Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:32:50.8423258Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:32:50.8423840Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:32:50.8424397Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:32:50.8424942Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:32:50.8425492Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:32:50.8426147Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:32:50.8426691Z 
2026-11-26T15:32:50.8426969Z # This function helps compare versions.
2026-11-26T15:32:50.8427583Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:32:50.8427990Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:32:50.8428340Z is_version_ge() {
2026-11-26T15:32:50.8428699Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:32:50.8429070Z }
2026-11-26T15:32:50.8429297Z 
2026-11-26T15:32:50.8429625Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:32:50.8430092Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:32:50.8430530Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:32:50.8430933Z   version_num="${input_cosign_release}"
2026-11-26T15:32:50.8431280Z   version_num="${version_num#v}"
2026-11-26T15:32:50.8431592Z 
2026-11-26T15:32:50.8431846Z   # Check if version is less than v2.0.0
2026-11-26T15:32:50.8432228Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:32:50.8432697Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:32:50.8433323Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:32:50.8433787Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:32:50.8434327Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:32:50.8434844Z     exit 1
2026-11-26T15:32:50.8435120Z   fi
2026-11-26T15:32:50.8435347Z fi
2026-11-26T15:32:50.8435755Z 
2026-11-26T15:32:50.8436001Z mkdir -p "${install_dir}"
2026-11-26T15:32:50.8436300Z 
2026-11-26T15:32:50.8436581Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:32:50.8437063Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:32:50.8437505Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:32:50.8437895Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:32:50.8438339Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:32:50.8438686Z   exit 0
2026-11-26T15:32:50.8438925Z fi
2026-11-26T15:32:50.8439146Z 
2026-11-26T15:32:50.8439380Z shaprog() {
2026-11-26T15:32:50.8439662Z   case ${runner_os} in
2026-11-26T15:32:50.8439955Z     Linux|linux)
2026-11-26T15:32:50.8440249Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:32:50.8440572Z       ;;
2026-11-26T15:32:50.8440822Z     macOS|macos)
2026-11-26T15:32:50.8441112Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:32:50.8441434Z       ;;
2026-11-26T15:32:50.8441692Z     Windows|windows)
2026-11-26T15:32:50.8442247Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:32:50.8442937Z       ;;
2026-11-26T15:32:50.8443177Z     *)
2026-11-26T15:32:50.8443474Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:32:50.8443820Z       exit 1
2026-11-26T15:32:50.8444068Z       ;;
2026-11-26T15:32:50.8444299Z   esac
2026-11-26T15:32:50.8444537Z }
2026-11-26T15:32:50.8444759Z 
