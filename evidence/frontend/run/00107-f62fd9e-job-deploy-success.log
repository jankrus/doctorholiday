2026-11-26T15:34:11.8718996Z         bootstrap_sha=${bootstrap_windows_amd64_sha}
2026-11-26T15:34:11.8719353Z         desired_cosign_filename='cosign-windows-amd64.exe'
2026-11-26T15:34:11.8719713Z         cosign_executable_name=cosign.exe
2026-11-26T15:34:11.8720055Z         bootstrap_executable_name=cosign-bootstrap.exe
2026-11-26T15:34:11.8720356Z         ;;
