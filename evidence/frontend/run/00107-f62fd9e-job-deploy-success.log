2026-11-26T15:34:11.8672033Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:34:11.8672356Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:34:11.8672737Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:34:11.8673036Z else
2026-11-26T15:34:11.8673264Z   alias log_info="echo \"INFO:\""
2026-11-26T15:34:11.8673615Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:34:11.8673882Z fi
2026-11-26T15:34:11.8674127Z set -e
2026-11-26T15:34:11.8674344Z 
2026-11-26T15:34:11.8674581Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:34:11.8675004Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:34:11.8675608Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:34:11.8676109Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:34:11.8676536Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:34:11.8676972Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:34:11.8677517Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:34:11.8677924Z 
2026-11-26T15:34:11.8678208Z # This function helps compare versions.
2026-11-26T15:34:11.8678520Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:34:11.8678914Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:34:11.8679208Z is_version_ge() {
2026-11-26T15:34:11.8679519Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:34:11.8679849Z }
2026-11-26T15:34:11.8680056Z 
2026-11-26T15:34:11.8680425Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:34:11.8680944Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:34:11.8681313Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:34:11.8681668Z   version_num="${input_cosign_release}"
2026-11-26T15:34:11.8681981Z   version_num="${version_num#v}"
2026-11-26T15:34:11.8682269Z 
2026-11-26T15:34:11.8682510Z   # Check if version is less than v2.0.0
2026-11-26T15:34:11.8682827Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:34:11.8683206Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:34:11.8683638Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:34:11.8684014Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:34:11.8684439Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:34:11.8684842Z     exit 1
2026-11-26T15:34:11.8685286Z   fi
2026-11-26T15:34:11.8685671Z fi
2026-11-26T15:34:11.8686105Z 
2026-11-26T15:34:11.8686365Z mkdir -p "${install_dir}"
2026-11-26T15:34:11.8686674Z 
2026-11-26T15:34:11.8686941Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:34:11.8687323Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:34:11.8687799Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:34:11.8688180Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:34:11.8688530Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:34:11.8688835Z   exit 0
2026-11-26T15:34:11.8689074Z fi
2026-11-26T15:34:11.8689285Z 
2026-11-26T15:34:11.8689500Z shaprog() {
2026-11-26T15:34:11.8689761Z   case ${runner_os} in
2026-11-26T15:34:11.8690024Z     Linux|linux)
2026-11-26T15:34:11.8690297Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:34:11.8690583Z       ;;
2026-11-26T15:34:11.8690819Z     macOS|macos)
2026-11-26T15:34:11.8691153Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:34:11.8691415Z       ;;
2026-11-26T15:34:11.8691668Z     Windows|windows)
2026-11-26T15:34:11.8692136Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:34:11.8692563Z       ;;
2026-11-26T15:34:11.8692808Z     *)
2026-11-26T15:34:11.8693056Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:34:11.8693375Z       exit 1
2026-11-26T15:34:11.8693608Z       ;;
2026-11-26T15:34:11.8693805Z   esac
2026-11-26T15:34:11.8694063Z }
2026-11-26T15:34:11.8694267Z 
