2026-11-26T15:34:11.8723544Z 
2026-11-26T15:34:11.8723735Z SUDO=
2026-11-26T15:34:11.8724082Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T15:34:11.8724418Z   SUDO=sudo
2026-11-26T15:34:11.8724668Z fi
2026-11-26T15:34:11.8724891Z 
2026-11-26T15:34:11.8725151Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T15:34:11.8726166Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T15:34:11.8727223Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T15:34:11.8727894Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T15:34:11.8728299Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
2026-11-26T15:34:11.8728782Z   log_error "Unable to validate cosign version: '${input_cosign_release}'"
2026-11-26T15:34:11.8729124Z   exit 1
2026-11-26T15:34:11.8729368Z fi
2026-11-26T15:34:11.8729697Z $SUDO chmod +x "${bootstrap_executable_name}"
2026-11-26T15:34:11.8729977Z 
2026-11-26T15:34:11.8730286Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T15:34:11.8730717Z if [[ "${input_cosign_release}" == "${bootstrap_version}" ]]; then
2026-11-26T15:34:11.8731239Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T15:34:11.8731776Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
2026-11-26T15:34:11.8732112Z   exit 0
2026-11-26T15:34:11.8732350Z fi
2026-11-26T15:34:11.8732602Z 
2026-11-26T15:34:11.8732879Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T15:34:11.8733241Z if [[ "${input_cosign_release}" =~ $semver ]]; then
2026-11-26T15:34:11.8733630Z   log_info "Custom cosign version '${input_cosign_release}' requested"
2026-11-26T15:34:11.8733984Z else
2026-11-26T15:34:11.8734334Z   log_error "Unable to validate requested cosign version: '${input_cosign_release}'"
2026-11-26T15:34:11.8734693Z   exit 1
2026-11-26T15:34:11.8734984Z fi
2026-11-26T15:34:11.8735197Z 
2026-11-26T15:34:11.8735562Z # Download custom cosign
2026-11-26T15:34:11.8736346Z log_info "Downloading platform-specific version '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}"
2026-11-26T15:34:11.8737302Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T15:34:11.8737944Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
2026-11-26T15:34:11.8738266Z 
2026-11-26T15:34:11.8738518Z # same hash means it is the same release
2026-11-26T15:34:11.8738836Z if [[ "$shaCustom" != "$shaBootstrap" ]]; then
2026-11-26T15:34:11.8739485Z   log_info "Downloading cosign public key '${input_cosign_release}' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub"
2026-11-26T15:34:11.8740353Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub
2026-11-26T15:34:11.8741018Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T15:34:11.8741410Z 
2026-11-26T15:34:11.8741698Z   log_info "Verifying public key matches expected value"
2026-11-26T15:34:11.8742107Z   $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "$RELEASE_COSIGN_PUB_KEY" -o public.key
2026-11-26T15:34:11.8742518Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T15:34:11.8742866Z   if [[ "$sha_fetched_key" != "$RELEASE_COSIGN_PUB_KEY_SHA" ]]; then
2026-11-26T15:34:11.8743289Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T15:34:11.8743660Z     exit 1
2026-11-26T15:34:11.8743883Z   fi
2026-11-26T15:34:11.8744130Z 
2026-11-26T15:34:11.8744367Z   if is_version_ge "3.0.1" "$version_num"; then
2026-11-26T15:34:11.8744731Z     # we're trying to get something greater than or equal to v3.0.1
2026-11-26T15:34:11.8745138Z     keyless_signature_file=${desired_cosign_filename}.sigstore.json
2026-11-26T15:34:11.8746046Z     log_info "Downloading keyless verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T15:34:11.8747035Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T15:34:11.8747542Z 
2026-11-26T15:34:11.8747897Z     log_info "Using bootstrap cosign to verify keyless signature of desired cosign version"
2026-11-26T15:34:11.8748778Z     "./${bootstrap_executable_name}" verify-blob --certificate-identity=keyless@projectsigstore.iam.gserviceaccount.com --certificate-oidc-issuer=https://accounts.google.com --bundle "${keyless_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:34:11.8749579Z 
2026-11-26T15:34:11.8749808Z     if is_version_ge "3.0.3" "$version_num"; then
2026-11-26T15:34:11.8750206Z       # we're trying to get something greater than or equal to v3.0.3
2026-11-26T15:34:11.8750601Z       kms_signature_file=${desired_cosign_filename}-kms.sigstore.json
2026-11-26T15:34:11.8751369Z       log_info "Downloading KMS verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T15:34:11.8752280Z       $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T15:34:11.8752796Z 
2026-11-26T15:34:11.8753220Z       log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T15:34:11.8753841Z       "./${bootstrap_executable_name}" verify-blob --key public.key --bundle "${kms_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:34:11.8754345Z     fi
2026-11-26T15:34:11.8754584Z   else
2026-11-26T15:34:11.8754908Z     signature_file=${desired_cosign_filename}.sig
2026-11-26T15:34:11.8755727Z     log_info "Downloading detached signature for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T15:34:11.8756681Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T15:34:11.8757179Z 
2026-11-26T15:34:11.8757541Z     log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T15:34:11.8758197Z     "./${bootstrap_executable_name}" verify-blob --key public.key --signature "${signature_file}" "cosign_${input_cosign_release}"
2026-11-26T15:34:11.8758698Z   fi
2026-11-26T15:34:11.8758972Z 
2026-11-26T15:34:11.8759285Z   $SUDO mv "cosign_${input_cosign_release}" "${cosign_executable_name}"
2026-11-26T15:34:11.8759721Z   $SUDO chmod +x "${cosign_executable_name}"
2026-11-26T15:34:11.8760138Z   # best-effort: on Windows the just-run bootstrap binary may still be locked briefly
2026-11-26T15:34:11.8760765Z   $SUDO rm -f "${bootstrap_executable_name}" || log_info "Unable to remove ${bootstrap_executable_name}, leaving it in place"
