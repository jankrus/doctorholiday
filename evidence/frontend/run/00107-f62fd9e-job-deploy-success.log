2026-11-26T15:34:11.8712546Z         bootstrap_filename='cosign-darwin-amd64'
2026-11-26T15:34:11.8712880Z         bootstrap_sha=${bootstrap_darwin_amd64_sha}
2026-11-26T15:34:11.8713272Z         desired_cosign_filename='cosign-darwin-amd64'
2026-11-26T15:34:11.8713564Z         ;;
2026-11-26T15:34:11.8713814Z 
2026-11-26T15:34:11.8714025Z       ARM64|arm64)
2026-11-26T15:34:11.8714297Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T15:34:11.8714680Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T15:34:11.8715009Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T15:34:11.8715328Z         ;;
2026-11-26T15:34:11.8715689Z 
2026-11-26T15:34:11.8715896Z       *)
2026-11-26T15:34:11.8716223Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T15:34:11.8716511Z         exit 1
2026-11-26T15:34:11.8716783Z         ;;
