2026-11-25T13:53:20.1957327Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:53:20.1957966Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:53:20.1958878Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:53:20.1959608Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:53:20.1960344Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:53:20.1961051Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:53:20.1961860Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:53:20.1962540Z 
2026-11-25T13:53:20.1962979Z # This function helps compare versions.
2026-11-25T13:53:20.1963548Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:53:20.1964102Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:53:20.1964605Z is_version_ge() {
2026-11-25T13:53:20.1965115Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:53:20.1965647Z }
2026-11-25T13:53:20.1966028Z 
2026-11-25T13:53:20.1966534Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:53:20.1967443Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:53:20.1968305Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:53:20.1968983Z   version_num="${input_cosign_release}"
2026-11-25T13:53:20.1969500Z   version_num="${version_num#v}"
2026-11-25T13:53:20.1969968Z 
2026-11-25T13:53:20.1970398Z   # Check if version is less than v2.0.0
2026-11-25T13:53:20.1970940Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:53:20.1971600Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:53:20.1998610Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:53:20.1999351Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:53:20.2000110Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:53:20.2000796Z     exit 1
2026-11-25T13:53:20.2001205Z   fi
2026-11-25T13:53:20.2001600Z fi
