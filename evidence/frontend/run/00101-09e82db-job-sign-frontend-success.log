2026-11-25T13:52:07.4859964Z #!/bin/bash
2026-11-25T13:52:07.4860341Z # Substitute environment variables in install-dir input
2026-11-25T13:52:07.4860779Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:52:07.4861163Z 
2026-11-25T13:52:07.4861420Z # cosign install script
2026-11-25T13:52:07.4861756Z shopt -s expand_aliases
2026-11-25T13:52:07.4862158Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:52:07.4862556Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:52:07.4862967Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:52:07.4863321Z else
2026-11-25T13:52:07.4863663Z   alias log_info="echo \"INFO:\""
2026-11-25T13:52:07.4863992Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:52:07.4864333Z fi
2026-11-25T13:52:07.4864579Z set -e
2026-11-25T13:52:07.4864904Z 
2026-11-25T13:52:07.4865189Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:52:07.4865622Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:52:07.4866167Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:52:07.4866645Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:52:07.4867326Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:52:07.4867836Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:52:07.4868521Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:52:07.4868980Z 
2026-11-25T13:52:07.4869281Z # This function helps compare versions.
2026-11-25T13:52:07.4869816Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:52:07.4870225Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:52:07.4870563Z is_version_ge() {
2026-11-25T13:52:07.4870972Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:52:07.4871341Z }
2026-11-25T13:52:07.4871600Z 
2026-11-25T13:52:07.4871926Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:52:07.4872393Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:52:07.4872804Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:52:07.4873176Z   version_num="${input_cosign_release}"
2026-11-25T13:52:07.4873553Z   version_num="${version_num#v}"
2026-11-25T13:52:07.4873882Z 
2026-11-25T13:52:07.4874164Z   # Check if version is less than v2.0.0
2026-11-25T13:52:07.4874531Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:52:07.4874976Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:52:07.4875414Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:52:07.4875831Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:52:07.4876323Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:52:07.4876773Z     exit 1
2026-11-25T13:52:07.4877283Z   fi
2026-11-25T13:52:07.4877645Z fi
2026-11-25T13:52:07.4878028Z 
2026-11-25T13:52:07.4878314Z mkdir -p "${install_dir}"
2026-11-25T13:52:07.4878627Z 
2026-11-25T13:52:07.4878960Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:52:07.4879405Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:52:07.4879797Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:52:07.4880179Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:52:07.4880701Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:52:07.4881097Z   exit 0
2026-11-25T13:52:07.4881410Z fi
2026-11-25T13:52:07.4881682Z 
2026-11-25T13:52:07.4881940Z shaprog() {
2026-11-25T13:52:07.4882254Z   case ${runner_os} in
2026-11-25T13:52:07.4882594Z     Linux|linux)
2026-11-25T13:52:07.4882894Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:52:07.4883234Z       ;;
2026-11-25T13:52:07.4883503Z     macOS|macos)
2026-11-25T13:52:07.4883849Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:52:07.4884163Z       ;;
2026-11-25T13:52:07.4884457Z     Windows|windows)
2026-11-25T13:52:07.4884957Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:52:07.4885465Z       ;;
2026-11-25T13:52:07.4885712Z     *)
2026-11-25T13:52:07.4886053Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:52:07.4886421Z       exit 1
2026-11-25T13:52:07.4886700Z       ;;
2026-11-25T13:52:07.4886974Z   esac
2026-11-25T13:52:07.4887406Z }
