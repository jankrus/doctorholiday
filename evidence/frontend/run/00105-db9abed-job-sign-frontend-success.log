2026-11-26T14:15:40.1045222Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-26T14:15:40.1066660Z ##[group]Run #!/bin/bash
2026-11-26T14:15:40.1067835Z #!/bin/bash
2026-11-26T14:15:40.1068193Z # Substitute environment variables in install-dir input
2026-11-26T14:15:40.1068612Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:15:40.1068961Z 
2026-11-26T14:15:40.1069274Z # cosign install script
2026-11-26T14:15:40.1069583Z shopt -s expand_aliases
2026-11-26T14:15:40.1069991Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:15:40.1070348Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:15:40.1070795Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:15:40.1071136Z else
2026-11-26T14:15:40.1071426Z   alias log_info="echo \"INFO:\""
2026-11-26T14:15:40.1071770Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:15:40.1072346Z fi
2026-11-26T14:15:40.1072662Z set -e
2026-11-26T14:15:40.1072929Z 
2026-11-26T14:15:40.1073213Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:15:40.1073655Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:15:40.1074141Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:15:40.1074629Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:15:40.1075133Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:15:40.1075579Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:15:40.1076142Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:15:40.1076625Z 
2026-11-26T14:15:40.1076910Z # This function helps compare versions.
2026-11-26T14:15:40.1077390Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:15:40.1077811Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:15:40.1078164Z is_version_ge() {
2026-11-26T14:15:40.1078510Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:15:40.1078868Z }
2026-11-26T14:15:40.1079151Z 
2026-11-26T14:15:40.1079477Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:15:40.1079887Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:15:40.1080327Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:15:40.1080678Z   version_num="${input_cosign_release}"
2026-11-26T14:15:40.1081026Z   version_num="${version_num#v}"
2026-11-26T14:15:40.1081313Z 
2026-11-26T14:15:40.1081640Z   # Check if version is less than v2.0.0
2026-11-26T14:15:40.1082481Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:15:40.1082978Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:15:40.1083470Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:15:40.1083891Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:15:40.1084380Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:15:40.1084844Z     exit 1
2026-11-26T14:15:40.1085115Z   fi
2026-11-26T14:15:40.1085383Z fi
2026-11-26T14:15:40.1085867Z 
2026-11-26T14:15:40.1086153Z mkdir -p "${install_dir}"
2026-11-26T14:15:40.1086505Z 
2026-11-26T14:15:40.1086790Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:15:40.1087248Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:15:40.1087660Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:15:40.1088052Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:15:40.1088584Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:15:40.1088943Z   exit 0
2026-11-26T14:15:40.1089234Z fi
2026-11-26T14:15:40.1089479Z 
2026-11-26T14:15:40.1089770Z shaprog() {
2026-11-26T14:15:40.1090048Z   case ${runner_os} in
2026-11-26T14:15:40.1090389Z     Linux|linux)
2026-11-26T14:15:40.1090695Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:15:40.1091049Z       ;;
2026-11-26T14:15:40.1091304Z     macOS|macos)
2026-11-26T14:15:40.1091645Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:15:40.1092176Z       ;;
2026-11-26T14:15:40.1092464Z     Windows|windows)
2026-11-26T14:15:40.1092968Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:15:40.1093507Z       ;;
2026-11-26T14:15:40.1093814Z     *)
2026-11-26T14:15:40.1094109Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:15:40.1094465Z       exit 1
2026-11-26T14:15:40.1094756Z       ;;
2026-11-26T14:15:40.1095013Z   esac
2026-11-26T14:15:40.1095260Z }
