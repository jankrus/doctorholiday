2026-11-25T13:44:18.1993568Z #!/bin/bash
2026-11-25T13:44:18.1993866Z # Substitute environment variables in install-dir input
2026-11-25T13:44:18.1994279Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-25T13:44:18.1994716Z 
2026-11-25T13:44:18.1994992Z # cosign install script
2026-11-25T13:44:18.1995255Z shopt -s expand_aliases
2026-11-25T13:44:18.1995623Z if [ -z "$NO_COLOR" ]; then
2026-11-25T13:44:18.1995973Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-25T13:44:18.1996315Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-25T13:44:18.1996635Z else
2026-11-25T13:44:18.1996891Z   alias log_info="echo \"INFO:\""
2026-11-25T13:44:18.1997185Z   alias log_error="echo \"ERROR:\""
2026-11-25T13:44:18.1997464Z fi
2026-11-25T13:44:18.1997676Z set -e
2026-11-25T13:44:18.1997914Z 
2026-11-25T13:44:18.1998147Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-25T13:44:18.1998517Z # Retry options shared by every release download below. GitHub's release
2026-11-25T13:44:18.1998940Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-25T13:44:18.1999339Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-25T13:44:18.1999796Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-25T13:44:18.2000232Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-25T13:44:18.2000726Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-25T13:44:18.2001447Z 
2026-11-25T13:44:18.2001676Z # This function helps compare versions.
2026-11-25T13:44:18.2002044Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-25T13:44:18.2002368Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-25T13:44:18.2002656Z is_version_ge() {
2026-11-25T13:44:18.2002988Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-25T13:44:18.2003290Z }
2026-11-25T13:44:18.2003516Z 
2026-11-25T13:44:18.2003786Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-25T13:44:18.2004142Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-25T13:44:18.2004645Z   # Extract version without 'v' prefix for comparison
2026-11-25T13:44:18.2004985Z   version_num="${input_cosign_release}"
2026-11-25T13:44:18.2005289Z   version_num="${version_num#v}"
2026-11-25T13:44:18.2005577Z 
2026-11-25T13:44:18.2005805Z   # Check if version is less than v2.0.0
2026-11-25T13:44:18.2006123Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-25T13:44:18.2006552Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-25T13:44:18.2006935Z     log_error "Requested version: ${input_cosign_release}"
2026-11-25T13:44:18.2007273Z     log_error "Please use cosign v2.6.0 or later."
2026-11-25T13:44:18.2007670Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-25T13:44:18.2008083Z     exit 1
2026-11-25T13:44:18.2008316Z   fi
2026-11-25T13:44:18.2008532Z fi
2026-11-25T13:44:18.2008819Z 
2026-11-25T13:44:18.2009027Z mkdir -p "${install_dir}"
2026-11-25T13:44:18.2009299Z 
2026-11-25T13:44:18.2009569Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-25T13:44:18.2009928Z   log_info "installing cosign via 'go install' from its main version"
2026-11-25T13:44:18.2010277Z   GOBIN=$(go env GOPATH)/bin
2026-11-25T13:44:18.2010602Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-25T13:44:18.2011127Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-25T13:44:18.2011407Z   exit 0
2026-11-25T13:44:18.2011628Z fi
2026-11-25T13:44:18.2011835Z 
