2026-11-25T13:44:18.2012284Z   case ${runner_os} in
2026-11-25T13:44:18.2012545Z     Linux|linux)
2026-11-25T13:44:18.2012822Z       sha256sum "$1" | cut -d' ' -f1
2026-11-25T13:44:18.2013094Z       ;;
2026-11-25T13:44:18.2013309Z     macOS|macos)
2026-11-25T13:44:18.2013582Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-25T13:44:18.2013845Z       ;;
2026-11-25T13:44:18.2014055Z     Windows|windows)
2026-11-25T13:44:18.2014499Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-25T13:44:18.2014916Z       ;;
2026-11-25T13:44:18.2015122Z     *)
2026-11-25T13:44:18.2015417Z       log_error "unsupported OS ${runner_os}"
2026-11-25T13:44:18.2015683Z       exit 1
2026-11-25T13:44:18.2015919Z       ;;
2026-11-25T13:44:18.2016124Z   esac
2026-11-25T13:44:18.2016329Z }
