2026-11-26T14:14:54.7186400Z         exit 1
2026-11-26T14:14:54.7186675Z         ;;
2026-11-26T14:14:54.7186876Z     esac
2026-11-26T14:14:54.7187130Z     ;;
2026-11-26T14:14:54.7187339Z 
2026-11-26T14:14:54.7187555Z   macOS|macos)
2026-11-26T14:14:54.7187834Z     case ${runner_arch} in
2026-11-26T14:14:54.7188089Z       X64|amd64)
2026-11-26T14:14:54.7188397Z         bootstrap_filename='cosign-darwin-amd64'
2026-11-26T14:14:54.7188718Z         bootstrap_sha=${bootstrap_darwin_amd64_sha}
2026-11-26T14:14:54.7189104Z         desired_cosign_filename='cosign-darwin-amd64'
2026-11-26T14:14:54.7189415Z         ;;
2026-11-26T14:14:54.7189640Z 
2026-11-26T14:14:54.7189870Z       ARM64|arm64)
2026-11-26T14:14:54.7190138Z         bootstrap_filename='cosign-darwin-arm64'
2026-11-26T14:14:54.7190490Z         bootstrap_sha=${bootstrap_darwin_arm64_sha}
2026-11-26T14:14:54.7190834Z         desired_cosign_filename='cosign-darwin-arm64'
2026-11-26T14:14:54.7191142Z         ;;
2026-11-26T14:14:54.7191380Z 
2026-11-26T14:14:54.7191599Z       *)
2026-11-26T14:14:54.7191864Z         log_error "unsupported architecture ${runner_arch}"
2026-11-26T14:14:54.7192197Z         exit 1
2026-11-26T14:14:54.7192540Z         ;;
2026-11-26T14:14:54.7192777Z     esac
2026-11-26T14:14:54.7193126Z     ;;
2026-11-26T14:14:54.7193421Z 
2026-11-26T14:14:54.7193711Z   Windows|windows)
2026-11-26T14:14:54.7193967Z     case ${runner_arch} in
2026-11-26T14:14:54.7194277Z       X64|amd64)
2026-11-26T14:14:54.7194578Z         bootstrap_filename='cosign-windows-amd64.exe'
2026-11-26T14:14:54.7194972Z         bootstrap_sha=${bootstrap_windows_amd64_sha}
2026-11-26T14:14:54.7195362Z         desired_cosign_filename='cosign-windows-amd64.exe'
2026-11-26T14:14:54.7195714Z         cosign_executable_name=cosign.exe
2026-11-26T14:14:54.7196092Z         bootstrap_executable_name=cosign-bootstrap.exe
2026-11-26T14:14:54.7196382Z         ;;
2026-11-26T14:14:54.7196583Z       *)
