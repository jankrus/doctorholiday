2026-11-26T14:14:54.7147703Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:14:54.7148024Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:14:54.7148407Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:14:54.7148730Z else
2026-11-26T14:14:54.7148968Z   alias log_info="echo \"INFO:\""
2026-11-26T14:14:54.7149281Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:14:54.7149564Z fi
2026-11-26T14:14:54.7149798Z set -e
2026-11-26T14:14:54.7150012Z 
2026-11-26T14:14:54.7150284Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:14:54.7150676Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:14:54.7151146Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:14:54.7151588Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:14:54.7152036Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:14:54.7152677Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:14:54.7153215Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:14:54.7153731Z 
2026-11-26T14:14:54.7153973Z # This function helps compare versions.
2026-11-26T14:14:54.7154331Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:14:54.7154700Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:14:54.7155012Z is_version_ge() {
2026-11-26T14:14:54.7155350Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:14:54.7155659Z }
2026-11-26T14:14:54.7155921Z 
2026-11-26T14:14:54.7156203Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:14:54.7156966Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:14:54.7157352Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:14:54.7157682Z   version_num="${input_cosign_release}"
2026-11-26T14:14:54.7158032Z   version_num="${version_num#v}"
2026-11-26T14:14:54.7158286Z 
2026-11-26T14:14:54.7158552Z   # Check if version is less than v2.0.0
2026-11-26T14:14:54.7158862Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:14:54.7159271Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:14:54.7159668Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:14:54.7160026Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:14:54.7160477Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:14:54.7160851Z     exit 1
2026-11-26T14:14:54.7161125Z   fi
2026-11-26T14:14:54.7161337Z fi
2026-11-26T14:14:54.7161619Z 
2026-11-26T14:14:54.7161889Z mkdir -p "${install_dir}"
2026-11-26T14:14:54.7162157Z 
2026-11-26T14:14:54.7162601Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:14:54.7163011Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:14:54.7163538Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:14:54.7163869Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:14:54.7164244Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:14:54.7164532Z   exit 0
2026-11-26T14:14:54.7164741Z fi
2026-11-26T14:14:54.7164977Z 
2026-11-26T14:14:54.7165195Z shaprog() {
2026-11-26T14:14:54.7165430Z   case ${runner_os} in
2026-11-26T14:14:54.7165716Z     Linux|linux)
2026-11-26T14:14:54.7165962Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:14:54.7166284Z       ;;
2026-11-26T14:14:54.7166505Z     macOS|macos)
2026-11-26T14:14:54.7166763Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:14:54.7167110Z       ;;
2026-11-26T14:14:54.7167333Z     Windows|windows)
2026-11-26T14:14:54.7167823Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:14:54.7168249Z       ;;
2026-11-26T14:14:54.7168477Z     *)
2026-11-26T14:14:54.7168749Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:14:54.7169037Z       exit 1
2026-11-26T14:14:54.7169293Z       ;;
2026-11-26T14:14:54.7169500Z   esac
2026-11-26T14:14:54.7169713Z }
2026-11-26T14:14:54.7169925Z 
