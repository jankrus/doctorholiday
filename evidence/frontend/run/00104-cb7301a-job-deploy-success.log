2026-11-26T14:14:54.7175195Z bootstrap_linux_ppc64le_sha="0887fca23319ea017cc827e6a845ba83722a36bf9e932f35c747ca83c14cec49"
2026-11-26T14:14:54.7175766Z bootstrap_linux_riscv64_sha="24f3865df0fd9b055827b888d56e13583112ac7d4c87b45967af1f0febf35455"
2026-11-26T14:14:54.7176300Z bootstrap_linux_s390x_sha="777978d576af893a3daf1fcf3b0e9178cebcbc083a669f6125b6c97b8e1fe433"
2026-11-26T14:14:54.7176886Z bootstrap_windows_amd64_sha="cbe953787074611f1334cbf37dc1cf953995bb8c45398eb4fc7bb781d29c1f2a"
2026-11-26T14:14:54.7177286Z 
2026-11-26T14:14:54.7177578Z cosign_executable_name=cosign
2026-11-26T14:14:54.7177955Z bootstrap_executable_name=cosign-bootstrap
2026-11-26T14:14:54.7178252Z 
2026-11-26T14:14:54.7178493Z trap "popd >/dev/null" EXIT
2026-11-26T14:14:54.7178761Z 
2026-11-26T14:14:54.7178995Z pushd "${install_dir}" > /dev/null
2026-11-26T14:14:54.7179265Z 
2026-11-26T14:14:54.7179496Z case ${runner_os} in
2026-11-26T14:14:54.7179787Z   Linux|linux)
2026-11-26T14:14:54.7180121Z     case ${runner_arch} in
