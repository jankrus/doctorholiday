2026-11-26T14:14:54.7184353Z         bootstrap_filename='cosign-linux-arm64'
2026-11-26T14:14:54.7184685Z         bootstrap_sha=${bootstrap_linux_arm64_sha}
2026-11-26T14:14:54.7185040Z         desired_cosign_filename='cosign-linux-arm64'
2026-11-26T14:14:54.7185360Z         ;;
2026-11-26T14:14:54.7185579Z 
2026-11-26T14:14:54.7185818Z       *)
