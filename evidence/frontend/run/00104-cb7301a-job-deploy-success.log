2026-11-26T14:14:54.7198968Z     ;;
2026-11-26T14:14:54.7199185Z esac
2026-11-26T14:14:54.7199436Z 
2026-11-26T14:14:54.7199633Z SUDO=
2026-11-26T14:14:54.7199932Z if [[ "${input_use_sudo}" == "true" ]] && command -v sudo >/dev/null; then
2026-11-26T14:14:54.7200279Z   SUDO=sudo
2026-11-26T14:14:54.7200516Z fi
2026-11-26T14:14:54.7200761Z 
2026-11-26T14:14:54.7201024Z expected_bootstrap_version_digest=${bootstrap_sha}
2026-11-26T14:14:54.7201772Z log_info "Downloading bootstrap version '${bootstrap_version}' of cosign to verify version to be installed...\n      https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}"
2026-11-26T14:14:54.7202958Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${bootstrap_version}/${bootstrap_filename}" -o "${bootstrap_executable_name}"
2026-11-26T14:14:54.7203643Z shaBootstrap=$(shaprog "${bootstrap_executable_name}")
2026-11-26T14:14:54.7204024Z if [[ "$shaBootstrap" != "${expected_bootstrap_version_digest}" ]]; then
2026-11-26T14:14:54.7204474Z   log_error "Unable to validate cosign version: '${input_cosign_release}'"
2026-11-26T14:14:54.7204841Z   exit 1
2026-11-26T14:14:54.7205107Z fi
2026-11-26T14:14:54.7205443Z $SUDO chmod +x "${bootstrap_executable_name}"
2026-11-26T14:14:54.7205759Z 
2026-11-26T14:14:54.7206055Z # If the bootstrap and specified `cosign` releases are the same, we're done.
2026-11-26T14:14:54.7206574Z if [[ "${input_cosign_release}" == "${bootstrap_version}" ]]; then
2026-11-26T14:14:54.7207096Z   log_info "bootstrap version successfully verified and matches requested version so nothing else to do"
2026-11-26T14:14:54.7207604Z   $SUDO mv "${bootstrap_executable_name}" "${cosign_executable_name}"
2026-11-26T14:14:54.7207972Z   exit 0
2026-11-26T14:14:54.7208184Z fi
2026-11-26T14:14:54.7208442Z 
2026-11-26T14:14:54.7208699Z semver='^v([0-9]+\.){0,2}(\*|[0-9]+)(-?r?c?)(\.[0-9]+)$'
2026-11-26T14:14:54.7209029Z if [[ "${input_cosign_release}" =~ $semver ]]; then
2026-11-26T14:14:54.7209452Z   log_info "Custom cosign version '${input_cosign_release}' requested"
2026-11-26T14:14:54.7209785Z else
2026-11-26T14:14:54.7210162Z   log_error "Unable to validate requested cosign version: '${input_cosign_release}'"
2026-11-26T14:14:54.7210528Z   exit 1
2026-11-26T14:14:54.7210737Z fi
2026-11-26T14:14:54.7210973Z 
2026-11-26T14:14:54.7211173Z # Download custom cosign
2026-11-26T14:14:54.7211986Z log_info "Downloading platform-specific version '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}"
2026-11-26T14:14:54.7213086Z $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${desired_cosign_filename}" -o "cosign_${input_cosign_release}"
2026-11-26T14:14:54.7213782Z shaCustom=$(shaprog "cosign_${input_cosign_release}");
2026-11-26T14:14:54.7214090Z 
2026-11-26T14:14:54.7214374Z # same hash means it is the same release
2026-11-26T14:14:54.7214693Z if [[ "$shaCustom" != "$shaBootstrap" ]]; then
2026-11-26T14:14:54.7215326Z   log_info "Downloading cosign public key '${input_cosign_release}' of cosign...\n    https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub"
2026-11-26T14:14:54.7216324Z   RELEASE_COSIGN_PUB_KEY=https://raw.githubusercontent.com/sigstore/cosign/${input_cosign_release}/release/release-cosign.pub
2026-11-26T14:14:54.7216971Z   RELEASE_COSIGN_PUB_KEY_SHA='f4cea466e5e887a45da5031757fa1d32655d83420639dc1758749b744179f126'
2026-11-26T14:14:54.7217407Z 
2026-11-26T14:14:54.7217669Z   log_info "Verifying public key matches expected value"
2026-11-26T14:14:54.7218115Z   $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSL "$RELEASE_COSIGN_PUB_KEY" -o public.key
2026-11-26T14:14:54.7218511Z   sha_fetched_key=$(shaprog public.key)
2026-11-26T14:14:54.7218880Z   if [[ "$sha_fetched_key" != "$RELEASE_COSIGN_PUB_KEY_SHA" ]]; then
2026-11-26T14:14:54.7219292Z     log_error "Fetched public key does not match expected digest, exiting"
2026-11-26T14:14:54.7219632Z     exit 1
2026-11-26T14:14:54.7219879Z   fi
2026-11-26T14:14:54.7220097Z 
2026-11-26T14:14:54.7220374Z   if is_version_ge "3.0.1" "$version_num"; then
2026-11-26T14:14:54.7220729Z     # we're trying to get something greater than or equal to v3.0.1
2026-11-26T14:14:54.7221116Z     keyless_signature_file=${desired_cosign_filename}.sigstore.json
2026-11-26T14:14:54.7221961Z     log_info "Downloading keyless verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T14:14:54.7223058Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${keyless_signature_file}"
2026-11-26T14:14:54.7223598Z 
2026-11-26T14:14:54.7223928Z     log_info "Using bootstrap cosign to verify keyless signature of desired cosign version"
2026-11-26T14:14:54.7224876Z     "./${bootstrap_executable_name}" verify-blob --certificate-identity=keyless@projectsigstore.iam.gserviceaccount.com --certificate-oidc-issuer=https://accounts.google.com --bundle "${keyless_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:14:54.7225673Z 
2026-11-26T14:14:54.7225947Z     if is_version_ge "3.0.3" "$version_num"; then
2026-11-26T14:14:54.7226388Z       # we're trying to get something greater than or equal to v3.0.3
2026-11-26T14:14:54.7226822Z       kms_signature_file=${desired_cosign_filename}-kms.sigstore.json
2026-11-26T14:14:54.7227645Z       log_info "Downloading KMS verification bundle for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T14:14:54.7228600Z       $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${kms_signature_file}"
2026-11-26T14:14:54.7229137Z 
2026-11-26T14:14:54.7229577Z       log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T14:14:54.7230181Z       "./${bootstrap_executable_name}" verify-blob --key public.key --bundle "${kms_signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:14:54.7230736Z     fi
2026-11-26T14:14:54.7230952Z   else
2026-11-26T14:14:54.7231252Z     signature_file=${desired_cosign_filename}.sig
2026-11-26T14:14:54.7232005Z     log_info "Downloading detached signature for platform-specific '${input_cosign_release}' of cosign...\n      https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T14:14:54.7233052Z     $SUDO curl "${CURL_RETRY_OPTS[@]}" -fsSLO "https://github.com/sigstore/cosign/releases/download/${input_cosign_release}/${signature_file}"
2026-11-26T14:14:54.7233678Z 
2026-11-26T14:14:54.7234025Z     log_info "Using bootstrap cosign to verify signature of desired cosign version"
2026-11-26T14:14:54.7234757Z     "./${bootstrap_executable_name}" verify-blob --key public.key --signature "${signature_file}" "cosign_${input_cosign_release}"
2026-11-26T14:14:54.7235246Z   fi
2026-11-26T14:14:54.7235537Z 
2026-11-26T14:14:54.7235858Z   $SUDO mv "cosign_${input_cosign_release}" "${cosign_executable_name}"
2026-11-26T14:14:54.7236256Z   $SUDO chmod +x "${cosign_executable_name}"
2026-11-26T14:14:54.7236745Z   # best-effort: on Windows the just-run bootstrap binary may still be locked briefly
2026-11-26T14:14:54.7237318Z   $SUDO rm -f "${bootstrap_executable_name}" || log_info "Unable to remove ${bootstrap_executable_name}, leaving it in place"
