2026-11-26T15:33:04.8456803Z ##[start-action display=Run #!/bin/bash;id=__sigstore_cosign-installer.__run]
2026-11-26T15:33:04.8478988Z ##[group]Run #!/bin/bash
2026-11-26T15:33:04.8479942Z #!/bin/bash
2026-11-26T15:33:04.8480324Z # Substitute environment variables in install-dir input
2026-11-26T15:33:04.8480781Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T15:33:04.8481127Z 
2026-11-26T15:33:04.8481407Z # cosign install script
2026-11-26T15:33:04.8481791Z shopt -s expand_aliases
2026-11-26T15:33:04.8482336Z if [ -z "$NO_COLOR" ]; then
2026-11-26T15:33:04.8482712Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T15:33:04.8483116Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T15:33:04.8483482Z else
2026-11-26T15:33:04.8483782Z   alias log_info="echo \"INFO:\""
2026-11-26T15:33:04.8484110Z   alias log_error="echo \"ERROR:\""
2026-11-26T15:33:04.8484433Z fi
2026-11-26T15:33:04.8484692Z set -e
2026-11-26T15:33:04.8484986Z 
2026-11-26T15:33:04.8485254Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T15:33:04.8485725Z # Retry options shared by every release download below. GitHub's release
2026-11-26T15:33:04.8486427Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T15:33:04.8486936Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T15:33:04.8487437Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T15:33:04.8487903Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T15:33:04.8488482Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T15:33:04.8488930Z 
2026-11-26T15:33:04.8489242Z # This function helps compare versions.
2026-11-26T15:33:04.8489768Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T15:33:04.8490179Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T15:33:04.8490534Z is_version_ge() {
2026-11-26T15:33:04.8490901Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T15:33:04.8491247Z }
2026-11-26T15:33:04.8491511Z 
2026-11-26T15:33:04.8491858Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T15:33:04.8492278Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T15:33:04.8492741Z   # Extract version without 'v' prefix for comparison
2026-11-26T15:33:04.8493156Z   version_num="${input_cosign_release}"
2026-11-26T15:33:04.8493493Z   version_num="${version_num#v}"
2026-11-26T15:33:04.8493814Z 
2026-11-26T15:33:04.8494102Z   # Check if version is less than v2.0.0
2026-11-26T15:33:04.8494493Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T15:33:04.8494913Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T15:33:04.8495362Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T15:33:04.8495793Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T15:33:04.8496438Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T15:33:04.8496893Z     exit 1
2026-11-26T15:33:04.8497204Z   fi
2026-11-26T15:33:04.8497463Z fi
2026-11-26T15:33:04.8497804Z 
2026-11-26T15:33:04.8498095Z mkdir -p "${install_dir}"
2026-11-26T15:33:04.8498434Z 
2026-11-26T15:33:04.8498725Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T15:33:04.8499155Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T15:33:04.8499560Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T15:33:04.8499965Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T15:33:04.8500476Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T15:33:04.8500901Z   exit 0
2026-11-26T15:33:04.8501154Z fi
2026-11-26T15:33:04.8501429Z 
2026-11-26T15:33:04.8501670Z shaprog() {
2026-11-26T15:33:04.8502022Z   case ${runner_os} in
2026-11-26T15:33:04.8502324Z     Linux|linux)
2026-11-26T15:33:04.8502642Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T15:33:04.8503003Z       ;;
2026-11-26T15:33:04.8503324Z     macOS|macos)
2026-11-26T15:33:04.8503734Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T15:33:04.8504058Z       ;;
2026-11-26T15:33:04.8504384Z     Windows|windows)
2026-11-26T15:33:04.8504872Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T15:33:04.8505386Z       ;;
2026-11-26T15:33:04.8505657Z     *)
2026-11-26T15:33:04.8506197Z       log_error "unsupported OS ${runner_os}"
2026-11-26T15:33:04.8506528Z       exit 1
2026-11-26T15:33:04.8506835Z       ;;
2026-11-26T15:33:04.8507142Z   esac
2026-11-26T15:33:04.8507414Z }
2026-11-26T15:33:04.8507663Z 
