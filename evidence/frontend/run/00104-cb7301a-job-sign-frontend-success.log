2026-11-26T14:13:49.6677348Z ##[group]Run #!/bin/bash
2026-11-26T14:13:49.6678439Z #!/bin/bash
2026-11-26T14:13:49.6678832Z # Substitute environment variables in install-dir input
2026-11-26T14:13:49.6679459Z install_dir=$(envsubst <<<"${input_install_dir}")
2026-11-26T14:13:49.6680002Z 
2026-11-26T14:13:49.6680295Z # cosign install script
2026-11-26T14:13:49.6680652Z shopt -s expand_aliases
2026-11-26T14:13:49.6681076Z if [ -z "$NO_COLOR" ]; then
2026-11-26T14:13:49.6681450Z   alias log_info="echo -e \"\033[1;32mINFO\033[0m:\""
2026-11-26T14:13:49.6682027Z   alias log_error="echo -e \"\033[1;31mERROR\033[0m:\""
2026-11-26T14:13:49.6682390Z else
2026-11-26T14:13:49.6682736Z   alias log_info="echo \"INFO:\""
2026-11-26T14:13:49.6683068Z   alias log_error="echo \"ERROR:\""
2026-11-26T14:13:49.6683400Z fi
2026-11-26T14:13:49.6683653Z set -e
2026-11-26T14:13:49.6683961Z 
2026-11-26T14:13:49.6684236Z CURL_RETRIES="${input_curl_retries:-6}"
2026-11-26T14:13:49.6684990Z # Retry options shared by every release download below. GitHub's release
2026-11-26T14:13:49.6685522Z # CDN intermittently returns transient HTTP 504s that can persist for
2026-11-26T14:13:49.6686083Z # ~15-20s, outlasting curl's default exponential backoff (~7s across 3
2026-11-26T14:13:49.6686573Z # retries). A fixed 5s delay with --retry-all-errors rides out those
2026-11-26T14:13:49.6687094Z # windows, while --retry-max-time 120 keeps a failing download bounded.
2026-11-26T14:13:49.6687684Z CURL_RETRY_OPTS=(--retry "${CURL_RETRIES}" --retry-delay 5 --retry-all-errors --retry-max-time 120)
2026-11-26T14:13:49.6688153Z 
2026-11-26T14:13:49.6688469Z # This function helps compare versions.
2026-11-26T14:13:49.6688967Z # Returns 0 if version1 >= version2, 1 otherwise.
2026-11-26T14:13:49.6689380Z # Usage: is_version_ge "3.0.0" "$version_num"
2026-11-26T14:13:49.6689727Z is_version_ge() {
2026-11-26T14:13:49.6690111Z     [ "$(printf '%s\n' "$1" "$2" | sort -V | head -n1)" == "$1" ]
2026-11-26T14:13:49.6690465Z }
2026-11-26T14:13:49.6690734Z 
2026-11-26T14:13:49.6691091Z # Check for unsupported old versions (anything below v2.0.0)
2026-11-26T14:13:49.6691520Z if [[ "${input_cosign_release}" != "main" ]]; then
2026-11-26T14:13:49.6692123Z   # Extract version without 'v' prefix for comparison
2026-11-26T14:13:49.6692521Z   version_num="${input_cosign_release}"
2026-11-26T14:13:49.6692902Z   version_num="${version_num#v}"
2026-11-26T14:13:49.6693225Z 
2026-11-26T14:13:49.6693516Z   # Check if version is less than v2.0.0
2026-11-26T14:13:49.6693907Z   if ! is_version_ge "2.0.0" "$version_num"; then
2026-11-26T14:13:49.6694340Z     log_error "cosign versions below v2.0.0 are no longer supported."
2026-11-26T14:13:49.6694805Z     log_error "Requested version: ${input_cosign_release}"
2026-11-26T14:13:49.6695216Z     log_error "Please use cosign v2.6.0 or later."
2026-11-26T14:13:49.6695711Z     log_error "See https://github.com/sigstore/cosign/releases for available versions."
2026-11-26T14:13:49.6696166Z     exit 1
2026-11-26T14:13:49.6696491Z   fi
2026-11-26T14:13:49.6696804Z fi
2026-11-26T14:13:49.6697757Z 
2026-11-26T14:13:49.6698050Z mkdir -p "${install_dir}"
2026-11-26T14:13:49.6698357Z 
2026-11-26T14:13:49.6698695Z if [[ "${input_cosign_release}" == "main" ]]; then
2026-11-26T14:13:49.6699129Z   log_info "installing cosign via 'go install' from its main version"
2026-11-26T14:13:49.6699537Z   GOBIN=$(go env GOPATH)/bin
2026-11-26T14:13:49.6699937Z   go install github.com/sigstore/cosign/v3/cmd/cosign@main
2026-11-26T14:13:49.6700348Z   ln -s "$GOBIN/cosign" "${install_dir}/cosign"
2026-11-26T14:13:49.6700705Z   exit 0
2026-11-26T14:13:49.6700965Z fi
2026-11-26T14:13:49.6701243Z 
2026-11-26T14:13:49.6701579Z shaprog() {
2026-11-26T14:13:49.6702256Z   case ${runner_os} in
2026-11-26T14:13:49.6702658Z     Linux|linux)
2026-11-26T14:13:49.6703028Z       sha256sum "$1" | cut -d' ' -f1
2026-11-26T14:13:49.6703357Z       ;;
2026-11-26T14:13:49.6703671Z     macOS|macos)
2026-11-26T14:13:49.6703998Z       shasum -a256 "$1" | cut -d' ' -f1
2026-11-26T14:13:49.6704329Z       ;;
2026-11-26T14:13:49.6704604Z     Windows|windows)
2026-11-26T14:13:49.6705129Z       powershell -command "(Get-FileHash \"$1\" -Algorithm SHA256 | Select-Object -ExpandProperty Hash).ToLower()"
2026-11-26T14:13:49.6705657Z       ;;
2026-11-26T14:13:49.6705919Z     *)
2026-11-26T14:13:49.6706258Z       log_error "unsupported OS ${runner_os}"
2026-11-26T14:13:49.6706584Z       exit 1
2026-11-26T14:13:49.6706937Z       ;;
2026-11-26T14:13:49.6707205Z   esac
2026-11-26T14:13:49.6707510Z }
