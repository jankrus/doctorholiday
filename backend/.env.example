# Copy to .env (never commit it) and replace every CHANGE_ME. The app starts only with valid values.
# Run with: make run  (= uv run --env-file .env python -m doctorholiday)

# PostgreSQL connection, driver must be psycopg (SQLAlchemy URL). Local database: `make db-up`
# (repo root); the password of the app role is in .secrets/db_app_password.
DATABASE_URL=postgresql+psycopg://doctorholiday_app:CHANGE_ME@localhost:5432/doctorholiday

# At least 32 characters. Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME

# 32 random bytes, base64url with padding (44 chars). Generate:
#   uv run python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_ENCRYPTION_KEY=CHANGE_ME

# Comma-separated browser origins allowed to call the API, e.g. the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# Optional
PORT=8080
LOG_LEVEL=INFO
# Login sessions end after this many minutes without a request (1-1440) and at the latest this
# many minutes after the login (1-10080, not shorter than the idle timeout).
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
# Login rate limiting: this many failed logins per e-mail address (1-100) or per client IP
# (1-1000) within the window (1-1440 minutes) lock it for the lockout time (1-1440 minutes).
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Registration rate limiting: this many requests per client IP (1-1000) within the window
# (1-1440 minutes) lock that IP for the window's length once more.
REGISTRATION_MAX_PER_IP=10
REGISTRATION_WINDOW_MINUTES=60
