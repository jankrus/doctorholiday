# Pinned versions of the cluster tooling (issues #40, #41, #42). Read by the Makefile and by
# scripts/k8s-*.sh. Upstream manifests are downloaded at `make up` time from a URL with an explicit
# tag and verified against the SHA-256 below before they are applied; a changed file fails the run.
#
# To update one: change the version and the URL, download the file once, check the diff, and
# replace the checksum with `sha256sum <file>`.

# kind itself (the CLI you install); the node image is pinned in kind-config.yaml.
KIND_VERSION=v0.33.0

# Calico: the network plugin that enforces NetworkPolicies. Its images are referenced by tag in the
# upstream manifest (not by digest), a known gap of this one component.
CALICO_VERSION=v3.32.3
CALICO_URL=https://raw.githubusercontent.com/projectcalico/calico/v3.32.3/manifests/calico.yaml
CALICO_SHA256=3db4c55514b678be853be49b8cb102bed0a00bc0343eec05ac191652dc7211e0

# ingress-nginx, the kind provider manifest (its images are pinned by digest upstream). Upstream
# published its last release on 2026-03-19; see docs/report/deviations.md.
INGRESS_NGINX_VERSION=controller-v1.15.1
INGRESS_NGINX_URL=https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.15.1/deploy/static/provider/kind/deploy.yaml
INGRESS_NGINX_SHA256=2a3ae008c8786431115502644e77ab398fdebfb721a5d1195ed3089cde3299df
