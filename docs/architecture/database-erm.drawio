        <mxCell id="n_rate_limits" value="PK (scope, key_hash) &#xB7; CK scope IN ('LOGIN_IP','LOGIN_ACCOUNT','REGISTRATION_IP',&lt;br&gt;&amp;nbsp;&amp;nbsp;'MFA_VERIFICATION_USER','INVITATION_ACCEPTANCE_IP',&lt;br&gt;&amp;nbsp;&amp;nbsp;'PASSWORD_RESET_IP','REAUTHENTICATION_USER')&lt;br&gt;CK octet_length(key_hash) = 32 (SHA-256 of IP, e-mail or user ID) &#xB7; CK attempts &amp;gt;= 0&lt;br&gt;IX (scope, window_started_at) &#xB7; no FK: unknown e-mails are counted too (V005, V006)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=10;fontFamily=Courier New;fillColor=none;strokeColor=#6c8ebf;dashed=1;whiteSpace=wrap;" vertex="1" parent="1">
