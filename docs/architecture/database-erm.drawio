        <mxCell id="n_appointments" value="EX USING gist (doctor_id WITH =, tstzrange(starts_at, ends_at) WITH &amp;amp;&amp;amp;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;WHERE (status = 'BOOKED')&lt;br&gt;CK ends_at &amp;gt; starts_at&lt;br&gt;CK status IN ('BOOKED','CANCELLED')&lt;br&gt;CK reason IN (BR-10 categories)&lt;br&gt;CK status = 'BOOKED' &#x21D4; cancelled_at, cancelled_by_id IS NULL&lt;br&gt;CK patient XOR guest XOR erased guest (three shapes)&lt;br&gt;CK guest_name: length 1&#x2013;100&lt;br&gt;CK guest_phone ~ '^\+[1-9][0-9]{1,14}$' (E.164)&lt;br&gt;IX (starts_at) &#xB7; IX (patient_id, starts_at)&lt;br&gt;IX (guest_phone) WHERE status = 'BOOKED'&lt;br&gt;Never deleted (BR-11)" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=10;fontFamily=Courier New;fillColor=none;strokeColor=#82b366;dashed=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1171" width="540" height="190" as="geometry"/>
        </mxCell>
